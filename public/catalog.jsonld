    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_r0br5tkr",
      "name": "ይሽ ጊዜ",
      "inLanguage": "am",
      "alternateName": [
        "Yish Gize",
        "This Time"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_ezmnrs41",
          "name": "ገብረ ክርስቶስ ደስታ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_0qnk9fq5",
          "name": "አማረ ማሞ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_tfjm9dtn",
          "name": "አምሃ አስፋው"
        }
      ],
      "genre": "poetry",
      "description": "ሃቻምና በረረ\nአምፍም ተሻገረ\nዘንድሮም ይሮጣል\nሀችን እየደገ ልጅ ይላግላል።\nይመፋል እርጌው ወማት አያርጅ\nጊዜ እየረደደ፡-\nተከማቾች አደም ላም\nእንደምን በረረ፡ ይገርማል፡ ኣይቆምም።\nመስከረም ሲቀበ ቀለም ጣምት ጣምት\nአላተምዎ ማደንዎነ ያረጀውን ፍጥረት\nየደራሰው መሬት።\nክረምቱም ሲገባ ማበንበ በውሃ\nበተራው ሲተክ በጋም ከበረሃ\nአላተምዎ ይበላል\nሁሉም ይንፍቀቃል\nገመዱን ሲታት ጊዜ ይቀለሳል።\nምን ይሆ ይህ ጊዜ?\nየሰአት እጆቹ ድምሙ ዉኁጔል።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_1xxqnc3g"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
