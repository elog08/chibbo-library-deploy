    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_2n3nbqx5",
      "name": "ወልቱ",
      "inLanguage": "am",
      "alternateName": [
        "Weltu"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "የዋየውን መንገረ እንሤጥሽ ስታር\nሳትማሙ ፤ ስትማሞ በአብቢር ሳትያር\nተሰለ ጫፍ ሁኝኝ ተሰለ ፊትበ\nእ-ማን ሳይወህንች የትም- የት- ስተ-ሄደ I\nእቲ ምን ምን አሰልሽ?\nወደአሳ ሼች ሸ?\nመስኝት ከማሌቱ ያስቃቀልሽ?\nወልቱ በሌላት ምን ይሆን ሐሰል\nእዛት መስአለችኝ ጕጅሽ ስተባብ",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
