    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_xsxx4dwa",
      "name": "ቋጥኝ",
      "inLanguage": "am",
      "alternateName": [
        "Qwatgn",
        "Boulder"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "መሠረት ጽን\nየበረከት ምሳሌ ነኝ ባይ\nቋጥኝ በሰዎች ላይ I\nንፍሰ ራሱንያየው\nማር ፋከላ ድንጋይ በልር\nአብሮአል ነገር\nልብራውም እንግለዎ\nሲገነጠለው እንደ ሰሰሰው ፤\n(ትዕግሥቱ ብቻ አየዋቸው)\nግና አንገት መብታ . . አንገት መብታ\nውይ ተሰነታ\nአስረድ አትንከስ\nድንጋይ አትንግር\nመቅያሰሽ\n(መሪብ አምታለመል)\nእፍ መፍት ቀላች መነመክ\nከማር ጸአ መወአደ\nእንደይረ እንደአፍክ ከእንታወ—\nእንዲለማት I\nወደ ፋልፋለ\nወልደ\n  ቋጥኝ\n  አየ\n  ተን\n  ልቶ\n  ሉ\n  +",
      "partOf": [
