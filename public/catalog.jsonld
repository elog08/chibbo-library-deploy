    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_gdgn2njp",
      "name": "አገር አንድ!",
      "inLanguage": "am",
      "alternateName": [
        "Ager And!",
        "One Country!"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_eqyqm5nd",
          "name": "ጸጋዬ ገብረ መድኅን"
        }
      ],
      "genre": "poetry",
      "description": "አገር አንድ!\n\nአርቀን ማስተዋል ማለት፥ የሽንኅ ሥልጣኔ ድልድይ\nአገር ማማት ነው ብለዋል፥ አስተ እንግዲህ አገር አንድ!\n    ያባቶቻችሁ ያይን ድንበር፥ ከተረከዘ አሮማ ሳይለፍ\n    አንተ ግን ጀነሎ-ዘልፍ\n    ወለፍ አየወሰንህ ገብል\n    ጥቚህ በዘመንህ ድድል\n    ዓይንህ በቚት አልፎ እንዳይለፍ፤\nቊህ ወዴፓ ጀግንነት የለ፥ ተዚህ የከበረ ሣ፡ፄ\nባለባህር የዱር ገደል፥ ስትነደፍ የአገር አቀጅ\nለሌሎችን በየቤቱ- 'ግለበ' ቀንህ ጥምር በመሬ\nቤር እንደማት ጀነል\nበከተማሁ ስታፈራ\nበስደድሁ መዝከ-ከተታ ሥራ\nካንዱ ቤሮ ሌላው ቤሮ፥ አበል በረከቱን በላህ\nያባቱን ወለ ተንትህ\nተመልቀምሁ ተስፋልልህ\nአመሳተሁ አቀላልሁ፥ የዚያን ቚለ ከዚህ ቚለ\nዘጋዝህ በቡና ምግሁ፥ አምቱህ ደመሙ ስተስያይ፤\nበዚህ ብቻ ሳታነክለው፥ ደም አየለህን የአገሪ ጠባይ\nከአማድ የቡና ስን ጋር፥ የዘመኑን ስትንያይ",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_jkwbag59"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
