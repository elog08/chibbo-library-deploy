    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_es33bkc4",
      "name": "ይርጋ ዓለም",
      "inLanguage": "am",
      "alternateName": [
        "Yirga Alem"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ይርጋ ዓለም\nዋ . . . ይርጋ - ለም\nየልጅነት ሕልም ቀለም\nየይቲን የህ-ትረው- መለር\nወርቃማውይ ገርር ፤\nዕብቀት ፤ ሥር-ሥር ፤ ፍለፍለ\nደቀጣም ፤ ገ-ደ ፤ ከንደእ...\nየጥመል እንባ የከውበት ፤\nእንሳት ቡና ፤ ቡና እንሳት\nሲየ-ሰሰኝ አ.ህ-ን-ሰ-ብ\nለሞርከርሽ ሲየ-ደርሞ-ሽ\nሳይክበርከኝ ፤\nካሳውን ሲመሐታልሽ\nሳየ-ሻሞኝ ፤ በረ-ጅጥ :\nዛሬ በከተ-ወ ታልከነ-ብ ።\nየተሰተረ እም-ልፍ ሣንጋ\nአረጋን ቤሙ ዌ-ት አፄ\nማን ነ-ቅ-ፎ ፤ እዩ ለልሽ?\nማን በቅ-ቀ ፤ ሲ.ደ-ርማ-ሽ?\nፍቅር-ኛ አንደ ጣም-pu-\nአመማብሽ በደ-ሰበ-\nምን. . . ከረት\nፍ-ለሰ. . . ዠ-ት\nሁ-ሳሽ ሳ-ሣ\nምን ይጠማል?\nአባ ሠ-አው እንደ ጥ-በ-ት\nወልሽ አንደልማማት\nገለ ቤ-ት ፡\nሰ-ይ እንት-ዛ-መ-በ\nአመማውን ሣ.ቀ ወይ?",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
