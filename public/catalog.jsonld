    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_bcggvqxh",
      "name": "አንድ አይን ስድስት የእግር ጣት ያላት ጸጋ",
      "inLanguage": "am",
      "alternateName": [
        "aned ayen sedeset yeeger tat yalat tsega"
      ],
      "genre": "picture book",
      "about": [
        "Story Book"
      ],
      "description": "አንድ አይን ስድስት የእግር ጣት ያላት ጸጋ ጸጋ ብርታት ያጣች አንድ አይን ስድስት የእግር ጣት ያላት ግመል ናት ሁሌም ቢሆን እረኛዋን ካማድን ማስደሰት እና በሌሎች እንስሳቶች ተቀባይነት አግኝታ መኖርን ነበር የምትመኘው ጸጋ የፈለገችውን ያህል ብትሞክርም ግን ክብ ቅርጽ እየሰራች ብቻ ነው መራመድ የምትችለው በዚህ መሃል…. አንድ መልካም የሆነ እንግዳ ሰው መጣ…",
      "image": "https://s3.amazonaws.com/BloomLibraryBooks/Q41EXYftHA%2f1743491547572%2fTsega+-+Amharic%2fthumbnail-256.png",
      "offers": [
        {
          "@type": "Offer",
