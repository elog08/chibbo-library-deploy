    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_rvx66gaz",
      "name": "ብቻ መሣኛችን",
      "inLanguage": "am",
      "alternateName": [
        "Bicha Mesanyachin"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "እንደ ፍሡሩ ሐሳባ እናትን አንጸር\nበደስታ ሐዘንን እንደ ተወቀዩ ፤\nእንኲንን እንዲህይን ስሐል እሰር\nዐይኝሽን ዐሡኲን አንፆን ቧልብም ።\nወይም\nታውሮ እንደ ኖረ እንደ እዠ- ገበዝ\nበድንገት ብላዎቹን እንዳደረገዘዝ\nበመላም ቤቱ እንኲን ጮራ-የታ\nዘው-በማለት ሲበሩች ፤ ብላ-የታ ፤\nእንኲው-ም ይደርሰቃል\nብላ-የም ድነሻል ።\nየወጣኛው ፀሐይ ጽልመት ሲሸሽ\nብቻ መሣኛችን\nብቻ መሣርች ።\n\n*   *   *",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
