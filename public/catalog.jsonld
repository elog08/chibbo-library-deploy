    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_qe5t0v6d",
      "name": "የሳቱ ልጅ (መጨረሻ)",
      "inLanguage": "am",
      "alternateName": [
        "Yesatu Lej (Meceresha)",
        "Child of Error (Conclusion)"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ሥራህ ይተዘነሃል መሆንህን የጻድቅ\nየመመንኰስ ኟፍ ማዕቀት\nየገዛበነት መስታወት\nየደመቀንት መጽሐፍ ።\n\nእለ ካንተ ወደብ ማን ሊመጣ\nአባቱን መስሎ የወጣ\nአንዲትም ያንቱ ልጅ የል\nጥበብን አፍሮ የጸለ\nአወፍሮ ያሰለና\nአንድም አንትን መሰሎ—አባቱን መሰሎ የሚለ ።",
      "partOf": [
