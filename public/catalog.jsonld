    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_wf47q1s3",
      "name": "ሚተራሊዮን",
      "inLanguage": "am",
      "alternateName": [
        "Miteralion"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_7vd86fyz",
          "name": "Dr. Alemayehu Wassie"
        }
      ],
      "datePublished": "2023-09-23",
      "about": [
        "Literature & Fiction"
      ],
      "description": "ሚተራሊዮን: Miteralion book by Dr.Alemayehu Wassie Eshete ከመጽሃፉ የተወሰደ ....\" አንድ ሁለት መቶ ሜትር እንደተጓዙ አንድ ጫማ በላይ በአንድ ጊዜ የማታስረግጥ የበሬ ምላስ የምታክል የሠርጥ መንገድ ተከትለው መውረድ ጀመሩ በግራ በኩል ጭው ያለ ገደል በቀኝ በኩል ደግሞ የሚያዝ የሚጨበጥ የሌለው ዐለት ከመንገዱ ጥበትና ተዳፋትነቱ ተጨማምሮ “‹ወደ ጽድቅ የሚወስደው መንገድ ጠባብ ነው› የተባለው ይሄ ይሆን?” አልኩ ትንሽ እንደተራመድን ለመውረድ ሰውነቴ ሲንቀጠቀጥ \" …. ….. \"አባ መዐዛ መንገድ ላይ ስንመጣ ስለ ኢነርጂ ዲስፔሽን የጠየቀኝ ትዝ አለኛና ‹ይሄ ሰው ስለዚህ ስፍራ ቀደም ብሎ መረጃ ነበረው ማለት ነው? እነዚያ ቦታዎችም ማስተንፈሻ ናቸው ማለት ነው?› አልኩ ለራሴ …..\"",
      "image": "https://addisbooks.com/wp-content/uploads/2023/09/Miteralion-book-by-Alemayehu-Wassie.jpg",
