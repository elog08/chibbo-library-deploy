    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_77gcmbf2",
      "name": "አፄ ቴዎድሮስ",
      "inLanguage": "am",
      "alternateName": [
        "Emperor Tewodros II of Ethiopia"
      ],
      "author": [
        {
          "@type": "Person",
