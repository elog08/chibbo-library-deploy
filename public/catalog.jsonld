    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_hpccbmrx",
      "name": "መስከረም (ቀጠሎ)",
      "inLanguage": "am",
      "alternateName": [
        "Meskerem (Qetelo)",
        "Meskerem (Continued)"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ድል ስንካናሩ ተአምር ደረሰኝ\nየምድረደሥችን ዜና መቀበልን\nየሰላም ታሪክ ትክክለኛነቱን\nየአሁኑ የቃንዶ ወልዳም ዎረር ምን መጠቀቤን\nአፋል ድድኅን በወደ ነጋታኝ\nየአባ መጥቃኝ የሺህ ከታሁን\nአይበላውም ወይ\n\n(በነጠላ - የወንድ ድምፅ)\n\nታድያማ ማን ያርች ቅሬውን\nታድያማ ማን የታት ታሪኩን\nየመልዳውን ?\n\n(በነጠላ - የሴት ድምፅ)\n\nአባቶች - እኙ\nዝግማቱን የፈታችሁ ልአሙን የታያችሁ\nቃል - አንደበት የሰጣችሁ\nበዝኘት ተናት ታሪክ ነው የራሳችሁ\nቅሬውም ነበር ሕይወታችሁ\n(የአልም አሳት በየበራ ጐደለችሁ)\n\n(በድምር - የሴትና የወንድ ባህር ድምፅ)\n\nየመልዳውም ታሪክ ፡ የመልዳውም ቅሬ\nይደደላል ከክብር ሰማይ ፤ ይደሣል ከምግብ አዳፍ\nየተባለ የሞቱኝ ሐሴ !\nየፍማል የታጀበ ወሴ !\n\n(በማዕከል - የወንድና የሴት ድምፅ)\n\nግብህ ፤-\nአስሟኝ ተራሮች አናት አፋአለሁ አስተውለው\nበቲታቸው አይናችሁ ቃችሁ ዙሪያ የውን ድዳው\nበሸልቀው በአምባው በቀት ሆነ በሰላው\nበደማው በበራው በቅላው ሆነ በዳው",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
