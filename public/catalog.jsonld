    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_sna9bqwn",
      "name": "አቤ የኔ ዝምታ ጣምርታ",
      "inLanguage": "am",
      "alternateName": [
        "Abe Yene Zimta Tamrta",
        "Abe My Silent Companion"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "አቤ የኔ ዝምታ ጣምርታ\nአይወለድ ቃል—አንጓት ።\nበከተማው በገማ\nበአኛማው በሸላፊው በራፋ\nበየቀውሉ በየዕርፍ ።\nአኰ-ጀት ሲቀላት እረፍ—\nፍጥረት ሳንደርባት ሲሞታ ፤\nሆን ብሎ በሺር ላይ ተገኘ\nየልኑ ማይነት ቀጥፄ\nፍርሃትን—ክብር አደረግፄ ጣምራ\nአልው—የኔ ድምፅ ተወቀቄ\nአልው—የኔ ልማን አፍኟ ፤\nሲጐትላት ጽማ አርማ\nሲነካኳ ንኟ ሞምሞም ።\nአቤ የኔ ዝምታ ጣምርታ\nአይወለድ ቃል—አንጓት ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
