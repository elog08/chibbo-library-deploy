    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_5bzscce7",
      "name": "የቅንጣትትን ዞር የዘርቱን ንጉማ ማደሪያ ሰዕቢ እሰክር",
      "inLanguage": "am",
      "alternateName": [
        "Ye-Qintatetin Zor Ye-Zertun Niguma Maderiya Se'bi Esekir",
        "The Orbit of the Particle"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "የቅንጣትትን ዞር የዘርቱን ንጉማ ማደሪያ ሰዕቢ እሰክር ።\nሕይወትን ማለምለም የምን የሞት ኪላ ማጣጣቶ ስብር ።\nከበደው ሲበሃ\nበብዞሃው ሲንሃ\nከመልዳም ጥቃት የወሰንት ያዎች ዘሃ ብርሃን\nአላሚየታለሁ\nዘረየሩን መለማ ቀጥቼታለሁ ።\nየፋፍ ፋፋም ሁኗ አይቻለሁ ።\nበጐራዕይ ደይባ ሲን-ላቲ መታም በታለው ዐርቀ\nበሕ-ጋይን በባህሙ ሳሳውቁሁ ሁሉ ያበ ከልል\nየቸው ውስጥ ብርሃን\nባለፈኸኑሽ ስሰጋዊ ትግነት ዩርደረ ወዝ እግማት\nእርክም አበ- ፥ ስርማንክ ፡ ሰው-ቅም አም-ታዎ\nሰው — በል ፎርማንደር\nደኝበር — ሰብር ዉን ዖ - ኘት ተኰአ\nበቀጥታ ፡ s.p.\nተመኘ ፡ ተኃልል በበራው ቀርቷል በበራፊያው ሁሉ ፡\nወንጌ ዘመዴ፡-\nየቸው ትማት ብርሃን ስንት መንገድ መታት እንጃ\nፈሰሰ\nበሰአዝት ፡ ምዕራፍ በንም ተመልፍ በቀማ ቸር\nግን ሁለጊዜ የትም ከሰላም ተሻሽ ከወቢ ጣምታ\nበሰዎች ሰዎች አብናና አሸኘ",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
