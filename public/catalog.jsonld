    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_snpjqwjn",
      "name": "ዕንስት",
      "inLanguage": "am",
      "alternateName": [
        "Ensit",
        "Woman"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ዕንስት\n\nዋ! አንቺ የምኝት አጥናፊ\nየወፊት ራዕይ ኀይሉ\nየአንደኛ ምዕራፍ።\n  ሁነትህን መላውት\n  ኧርሽን ተቀቅኧት\n  የማትጨመጪ ጒም\n  የአልም ሕልም አላም ።\n\nሐደ ሐደ ደለግሽን ተከትፔ\nኃልብትን አባብኧ ቅንኧን ጥዬ\nእንዲና ተደሳለ . . .ወደሳለ\nክፍም በድኔ ጥለ\nከዕንግበ ከላላ ።\nእስቲ አየኝ አስተውዬ\nባይዎችሽ መለር ሞረች\nየተወ-ም ዜማሽ አሃዟኝ\nበቃ ልብሽ አርፍኧኝ ፤\nባልሽ ለማንደፈማች\nበስበአባልሽ አቃቴኝ !",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
    {
      "@type": "Book",
