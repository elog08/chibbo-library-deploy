    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_mj3aweje",
      "name": "ሰዉ ነው የረፈቀ",
      "inLanguage": "am",
      "alternateName": [
        "Sew New Yerefek'e",
        "It Is Man Who Lags"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_ezmnrs41",
          "name": "ገብረ ክርስቶስ ደስታ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_0qnk9fq5",
          "name": "አማረ ማሞ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_tfjm9dtn",
          "name": "አምሃ አስፋው"
        }
      ],
      "genre": "poetry",
      "description": "ሰዉ ነው የረፈቀ\nከማርከሬ ቬሻ፥ ከማረፊ ከማርክ\nከተለቀች ጌትቆች፥ አራክስ የለቀ\nበ፳ጀተርC ሳተርC፥ ከማ፲፪ የደመቀ\nባለባለዉ ሁሉ እያሸነፈC፥\nሰዉ አደግ አወቀ፡\nመሬት እንቀላለትን በበረ መጣቀ፲\nሰዉ አለምን አየ . . .\n\nበጨላማዉ ቦታ ይቃ አንባለቂ\nዉብ ሰማያዊ ከዋክብ፥ ፲፲፫ 3 አበራፈላቂ፡-\nበተጠራዉ አየር በነማዉ ደመና\nባረንትያዉ ባህር ዉሃ ተሻፍፋ፬፡-\nዉብ አለ ልብብ አለም፥ የመሰረ በደ ዉሂ፡-\nየሰዉ ልጆች እናት፥ የሰዉ ልጆች በሊ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_1xxqnc3g"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
