    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_3h2rbpbe",
      "name": "ምንድን ነሽ",
      "inLanguage": "am",
      "alternateName": [
        "Mindin Nesh",
        "What Are You?"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_ezmnrs41",
          "name": "ገብረ ክርስቶስ ደስታ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_0qnk9fq5",
          "name": "አማረ ማሞ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_tfjm9dtn",
          "name": "አምሃ አስፋው"
        }
      ],
      "genre": "poetry",
      "description": "ምንድን ነሽ\n\nነፋስ ወይም አየር ውሃ ነሽ አንቀሳፊት\nመልክሽ ወይም ሲያጥን ብርሃን ወይም ዕለት\nአስተረስሁዎ ስራሽን በጥጥ\nድንጋይ፥ አፈር፥ ጭቃ፥ ቸሌ፥ እእቊ፥ ሊጥ\nብረት፥ ነሃስ፥ መዳብ፥ ወርቅ፥ አላ፥ አላማሃ\nአገልግሎ ለአሪ፥ ለፔየ የሚያዝ\nቀይ ነሽ፥ ቢጫ ነሽ፥ አረንጓዴ ጥቁር\nሃምራዊ ቡና አድካት፥ ቀላም የሚቀርቊ::\nፋንገ ነሽ ስለካከ ፉንጅ ወይም መጥረ\nየማር አንጀል ነሽ የወጣ ከቀሮ\nወለላው በጃሽ ሰው ተማርቀ\nናለየን ያዘረው ከበታ አቃፍ\nአውር ነሽ ረሂም ወፍራም ወይም ጭቊ፥\nወርደና በፋትሽ ለብ ምን ይሆን፥\nአለሽ የአሸም ባትያዎ አለሽ\nማፍጠሽ የሟተቀር ሤር ወለለ¹ ነሽ::\nየምታቀይ ፋሬ ነሽ በበርቤ\nአላት ልቦለብ ነሽ እስከለሽኝ ዛሬ::\nሃገ በነጻዩ የለሆም ፕሊያ ነሃ²\nእርምት የፈጣረ ነሽ ወይ አሰትንፋስ\nእውነት ቀሬ ረቂቅ የማይደርስ\nሃይለ ነሽ ምርከቤ ብርታትፈ ጠናዩ\nሙትቴ ማኅቤ፥ እይኝና አፍንጫቤ\nአፌ ጀሮዬ ነሽ ጥርስ አትንፋስ\nእንግለ ነሽ አንተ የማሬ የቊ ጌታ\nደግደሽ የያዘሺኝ የሆንሺኝ መበታ\nአልደሽ ነሽ ፍለቢሽ መካና ልቦበሽ\nየምታፍርሺ ጎትኃቀበደ.\nዋለሽ ነሽ አርማሽኝ ሣፍኘ ሳንፄ\nሰለቀ የምርጥ አሰረሽኝ ስትለፄ\nመኖርሽን አን፲ ስሜትሽ ህልም ነው\nየፈቀው ሰማይ ነሽ የማይሰበስው\nየተረሳሽው ነሽ ያልደው ትናንት፥\nማነው የማይሰብሽ አእለሁበት፥\nሸፍና ቅባት የተላወ መካሂ፥\nየውሃ ሸታ ነሽ የተላመ ለዛ፥\nኜየ ወደት የሆነ የለም ቅብል³\nግዳም የገባ ነው የም ተ መነከቤ::\nየምታሤውቸው ሙዚቃ የተለ?\nአፉና ምለስ ድምቀም ግም ግለ::\nእኔ ነሽ የሆንከት ባለመቀው አንቺኝ፥\nእኔ ብዬ ሳንፄ ጤና ሰላሙኝ÷\nባለባ ማሰሪያ የፈጠርቺሽ እኔፄ\nበታም ይሰሙሽ ዕደፍና ከሡፄ፥\nበቅርዕ አላምል በቀለም ቀብፄ፤\nየእግዚአብሔርን ፀዳል ብርሃንን ሰፕፄ፥\nየሤን ማሞት መሳማት መሆኑ ካለቀው\nባለቀው መሆኑን ሃብነን ቢም ላው::",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_1xxqnc3g"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
