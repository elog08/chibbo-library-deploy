      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_ezmnrs41",
          "name": "ገብረ ክርስቶስ ደስታ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_0qnk9fq5",
          "name": "አማረ ማሞ"
        },
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_tfjm9dtn",
          "name": "አምሃ አስፋው"
        }
      ],
      "genre": "poetry",
      "description": "ኢ.ዮ.ሃ!\n\nኢ.ዮ.ሃ!\n      አበባ ፈካች!\nፀሀይ ወጣ ጨረሰ\nዝናብ ዘነበ አባራ\nካፍ አብቦ አፈሰ፭\nክረምት መጣ ሄደ\nዘመን ተወለደ\n     አዲስ ዓለም ሆነ።\nሌት ሲረገ . . .\n     ይረው ድንጋይ ክሰል\n     የተንተለተለ ፍም እሳት ደመሳው፥\nፀሀይ ያደረው።\nአለም ሞ ቀ\n     ድምፅ ፥\nብርሃን ሲሸነበቅ\nመላዎ በብረፈላቀ፥\nህይወት ሲያንበለበ\nፍጥረት ሲንመረመ፥\nዘመን ተለመደ መስከረም አበረ።\n«ኢ.ዮ.ሃ አበባዬ።»",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_1xxqnc3g"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
