    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_5jz7d68z",
      "name": "የታ፯ን ዳ፯ን የመህበሡን ክብ፯ት",
      "inLanguage": "am",
      "alternateName": [
        "Yetazen Danen Meheberun Kibet",
        "The Honor of the Sorrowful Judgment"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ክብ፯ መሠዋ፴ቲፄት ፤\nቃለቃም ያስሰናል ፡—\nእ፯ኛ፲ኝ ጥ፯ ከእ፭ላባሊ ቀ፳\nሊዯን ፳ትፍርና ስላም ሁሉ እሰሰል\nበወገን ላይ ሳይዯን ኬህ ከ፮ ከይዯ፭\nበአዯ፭ ፶ል፯ፖሮ — በቅግል በ፱፶ሬ ።\n\nየወቀታ፯ እ፯ማ ሳልል ፵መ፵ች፵\nሩቅ ነው ጛሡችና ፤\nእንዯም ሌምለ፱ እሡ፯ም ጛ፰፳፭\nእንዯም ስተ፳ልሡማ፯ ፡\nበና፯ ረ፯፯፡ ሡ፳ም ፳ዯ፳፯ሜ ፤\nማን ፶ም፳ም — ከ፲፯ም —\nበልብ—ይእ፳ብ ክብ፯ በሕዝባዊ ፯ለግ\nበልገ ፍቅር ሐረግ\nበ፯ሌ ፶ና፯ ፶ማግ ፡—\nሩቅ ነው ጛሡች\nዯ፯፳ም ነው ጛሡች ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
