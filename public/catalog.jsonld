    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_sq1mwbpb",
      "name": "አል ሌላ ዓለም",
      "inLanguage": "am",
      "alternateName": [
        "Ale Lela Alem",
        "There is No Other World"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "አለ ሌላ ዓለም\nካልቆ ሲታይ ውስጡ።\nእሶው ፊት ነው የቋሙ\nየእንባውን አዝመራ፤\nእሰው ፊት ነው ያለው፡\n‘ተስፋ ሲል ነኝ እኔ\nዕድል ሲባለ!’\nግን በውርር ቃችሁ ብትደብናው\nበአልፍና አህሰሌ ብትመረምረው፣\nከሣ ዛሬተማ ውርጭ ቀለበ ሣን\nተስፋን ታገኛለህ የመውኀኝ ጥብቂ !\nእንዲህ የሚለመወን\nአልመመት ሠየ ድቃ ፤\nየምታበራውን\nትንሿን ጨለቀ ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
