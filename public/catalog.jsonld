      "@id": "https://chibbo.app/work/wk_h0jstj3d",
      "name": "በንትን ያሻውን ዘር",
      "inLanguage": "am",
      "alternateName": [
        "Bentin Yashawun Zer",
        "Planting Whatever Seed"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "በንትን በሰርግአው\nበማጥ በደሙ\nእንዲ ተንደለለ—እንደሰመኝ\nትንሿኑን እንደ አጠርን\nልብ ቀብቱን እንድንበረክ I\nየተአክሂውን አባል።\nየሕይወቱን ቃለ—አዝዘ\nወርወር ! -\nየእጅህን በርርከ ።\nበንትን !\nየሻውን ዘር ።\nይኸው እእንብቀበር ።",
      "partOf": [
