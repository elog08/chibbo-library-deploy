    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_0t1f36m5",
      "name": "እነሆ በቀ",
      "inLanguage": "am",
      "alternateName": [
        "Eneho Beqe",
        "Behold the Leaf"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "እነሆ በቀ\nበይነችን ለማየት ደምቃና ተፍክህች\nቿ በላ ፡ ፈገረች ፡\nከዛሬን ደረሰች ፍሬዋን አደሰች ከረመታችን\nየሰላምን ዋጋ—የእውነትን ዋጋ—የዕዕረፍትን ዋጋ\nልአትን አስታምሮ ለሰው ልጅ በተጭ\nባፈ ፡ ያጳየው\nወረቀት ፡ ያልነካው\nቀለም ፡ ያልሰነካው\nሐቀኛ ታሪኩን ፡ ዜናውን ከፍፍ ጐባይ ገርግ ታኛ ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
