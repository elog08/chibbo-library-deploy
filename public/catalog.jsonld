    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_czmtv0ss",
      "name": "የግጥም ክፍል",
      "inLanguage": "am",
      "alternateName": [
        "Yegitim Kifil",
        "Poem Section"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_xgde6t8m",
          "name": "መክብብ ደስታ"
        }
      ],
      "genre": "poetry",
      "description": "ክብር፥ አቶ፥ ገለር፥ ሀለረ፥ እግዚአብሔር፥ የኢትዮጵያ፥ መንግሥት፥\nጉዳይ፥ ዋና፥ ጸሐፊና ።\nየማንነትን፥ ጽሞና፥ በቀልደ፥ የተመሰለችው፥ ሕዝብ፥ በላም፥\nየሰመረ፥ ጽናት፥ አቀደ፥ ፍርድ፥ አደላደለው፥ እዚህ፥ ።\nየተደላደለውንም፥ በቀልደ፥ የተመሰለችው፥ ሕዝብ፥ በላም፥\nየሰመረ፥ ጽናት፥ አቀደ፥ ፍርድ፥ አደላደለው፥ እዚህ፥ ።\nየተደላደለውንም፥ በቀልደ፥ የተመሰለችው፥ ሕዝብ፥ በላም፥\nየሰመረ፥ ጽናት፥ አቀደ፥ ፍርድ፥ አደላደለው፥ እዚህ፥ ።\n\nእንደምረሱት፥ የኃይለ፥ ሥላሴ፥ መታሰቢያ፥ ለመጀመርያ፥\nበየዓመቱ፥ ጸሎት፥ እናደርጋለን፥ አቶ፥ ኢዮብ ።\n\nክብር፥ ሐሤምኝ፥ ተደለለ፥ በምዕራብ፥ አገር፥ ተሠርቶ፥ መሠረተው፥ በወልድ፥\nበመሠረታቸው፥ ልጆች፥ የደስታቸው፥ ከነ፥ ኢዮብ፥ የመሠረቱት፥ ፩፥\nድምፅ፥ ካገር፥ ወጣቶች፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥\nየደርጅ፥ ከነኢዮብ፥ እንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከነኢዮብ፥\nእንዲደልል፥ በየመስኩ፥ የደርጅ፥ ከ