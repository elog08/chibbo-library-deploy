    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_zqphwhvf",
      "name": "ክፍል ፩ የምስጋና ቅኔ",
      "inLanguage": "am",
      "alternateName": [
        "Kifil 1: Yemisgana Qine",
        "Part 1: Poem of Thanksgiving"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_xgde6t8m",
          "name": "መክብብ ደስታ"
        }
      ],
      "genre": "poetry",
      "description": "አህጉረ፡ ኢትዮጵያ፡ መንግሥት፥ ዝናም፡ ንፋስ፡ ተለወጠ፥\nዕውቀት፡ እንደገና፡ የሚያገኘውን፡ መሠረትውን፡ አስተካከለ፥\n30ቀ፡ የምስጋናችንን፡ አሰማነው።\nአልናፍቅም፡\nይበቃኛል፡ ተጠምጌ፥\nየብሶቴን፡ ተራራ፡\nበፊት፡ አየሁት፡ በዓይን፡ በገለጻ፡\nአሁን፡ ግን፡ ገለጻ፡ የለም፡ በሰማይ፡\nአልማዝ፡ እንቁ፡ እንደምን፡ ታገኛለህ፡\nበሐሩር፡ በረሐ፡ በድንጋይ፡\nዕውቀት፡ የለዉም፡ ድንበር፡ የለውም፡\nፍቅር፡ ይሰማል፡ በመንፈስ፡ ቅዱስ፡\nበጨለማ፡ ውስጥ፡ እንገኛለን፡\nበአንድ፡ ቀን፡ ብርሃኑ፡ ይወጣል፡\nበሥራ፡ ላይ፡ እንገኛለን፡ ማስተማር፡\nተሰጠኝ፡ ጸጋ፡ ከፈጣሪ፡\nመጽሐፍ፡ ተጻፈ፡ ለዓለም፡ ሕዝብ፡\nይድረስ፡ ለአቶ፡ መሰንበት፡\nለአንድ፡ የታደለ፡ ሰው፡\nየአማርኛ፡ መጽሐፍ፡ በግዕዝ፡ ቋንቋ፡\nየተጻፈ፡ ስለሆነ፡ እናመሰግናለን፡\nበዓለም፡ ዙሪያ፡ ሰላም፡ ይሁን፡\nለኢትዮጵያ፡ ሕዝብ፡ ሁሉ።",
      "partOf": [
