    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_ckda910r",
      "name": "የቤት ስልክ ሲሆን አገልግሎት ስላமைን በትንሳኤ 2005 በላችሁ ደውሉ",
      "inLanguage": "am",
      "alternateName": [
        "Yebeit Silek Siyhon Agelgilot Silamein Bêtensae 2005 Belachu Dewlu",
        "Call us during Tesfae 2005 when the home telephone is in service"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_y4yb8sp6",
          "name": "ኤፍሬም ስዩም"
        }
      ],
      "genre": "poetry",
      "description": "66 . . . የቤት ስልክ ሲሆን አገልግሎት ስላமைን በትንሳኤ\n2005 በላችሁ ደውሉ\n\nፈሊጆች\n ትውልድ ይቀጥላል . . . አሁን\n እስከዚያው እናታችን በብርጭቆ ላይ ሣወረንቺኝ (ታታው በነሄድ\nከገኘነው) ውርን መካከል በደም የተጣበነውን ቀን እነሆ። ያለንን እንደ\nወርች ስለመታፋችን እንደ መምገር ይሆናል ዘንድ እነሁ ቤታችንን በበራፉ\nአሳየናችሁ።\n\nልጆች\nለለቆች . . .\n\nገለባጭ\nለየትም\nለማንም\nለመንឞም\nለሞንም\n\nይቅርታ . . .\nየሆነ የስልክ ጥሪ ይሰማልჴ።\nሃሎ? . . .\nሃሎ!\nሃሎ። . . .\n\nኤፍሬም ስዩም ተሰማ ነኝ\nሀለዎ",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_bh5zp6ct"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
