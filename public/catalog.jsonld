    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_xmkqhgys",
      "name": "የሤትማ ግርዋት (ቀጥሎ)",
      "inLanguage": "am",
      "alternateName": [
        "Yeshetma Girwat (Qetlo)",
        "The Women's Weeping (Continuation)"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ካረ ፈለሙ የተባለ ቃሉን ነሣችው\nቀና ድምጹን ደብሻችሁ ።\nደለ ወሰደ ፤ ከኃጅ ጋር ሲወሽችሁ ፤\nአላህንሰ አስለቀሰሽ መሬፋችሁ ።\nዐልፎ ከእለፍም ልጃችሁ ።\n\nግን የኔ እንጎ አላመናችሁም እንደሆነ የደመሰነ\nየሤትማ ግርዋት አለለ ።\nወይ የችመት ወለለ ፤\nእንዳች እኟ ፤ እንዳች እኟ ወዚችሁን የሰጠችሁ\nእንዳች እኟ ፤ እንዳች እኟ ሰቀቀንን የቻላችሁ ።\n...ደራሲ ፤ ታሪክ ቃንት የናታችሁ ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
