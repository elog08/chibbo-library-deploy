    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_kyscwawn",
      "name": "ትዝታን ማስታወስ",
      "inLanguage": "am",
      "alternateName": [
        "Tiztan Mastawes",
        "Remembering Memories"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "አየሽ ፤ አንደ ቀን ደም . . ደም\nየሔደበት መንገድ አዝማም\nይወማልናከርም . . አከርም\nሲ፟ፈቺሽ . . ማማ ሲለበሽ\nምልማዬ ሲበርቅብሽ\nምንቅ ጥዬ ሲመርደን\nአትበርጋይ አደረጃት\nዝምታዬ ሲመሀበሽ ።\n\nለታን ትካዜ መብክህን\nፍቅር ጥለኝ ስቀቀን\nቀናት ቅላት መማነን\nወረር ባለፍቲ በመልአን ።\n\nተፈራ ፍራኝ አልበ\nበጣም በሰርጌት ተሰበ\nአስገባት ነጻ ልበ\nበድንገተኛው ተማምሮ ።\n\nአና ለለመደቅ ለምኪክለል\nተፈሮንን አሚየሀል ግደል\nየቱ አል\nበዬ ነው I\nእኔው\nየተበደይ ፍቅር ባደ ራለው።\nእንገባኝ ከበየችሽ አግበለው ።",
      "partOf": [
        {
