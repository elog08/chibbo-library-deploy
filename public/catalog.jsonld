    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_24nw70s0",
      "name": "ፍቅርና ተግባር (አንድ ቅንጣት አባባ)",
      "inLanguage": "am",
      "alternateName": [
        "Fikirna Tigbar (And Qinitat Ababa)",
        "Love and Action (A Fragment of a Statement)"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "እንካ ነገ ቀርቶ -\nውስጥ ደግነት ትዝታው እጆቿ\n  ጸርፋ ገጽታ\nበተለይ ይላል\nየታየ አየ እያደር ተለቶ\n እያደረ መፍቶ ፥\nአንድ ነገር ብቻ\nአለ አንድ ነገር ከክ ኲደ ቀርቶ\nባይኖቼ ማዕዘን እንግ አያስከበር\nየፍቅ ዘመን ልብ ማዕን እየቀሰ\n  ካሬን እየደረ ፥\nበዚያች መጠቅ ሰዓት -\nአማታችን ቧን በፈቅር እሟእታ\nበተግባርም ጥለ መልክት ማማማት\nእንግኛ ዓዳጁ\nዓዳችን አንቺ ከፍታሁት ልብን\n ሁለት ሁለት ቦታ ፥\nበዚያ መሰናሰ መገድ ላይ እንደ ቆሙ •\n አስብ ሳመነህ ፥\nቀታልሰ የሰጠችኝ\nበለይ ጠቆችህ የች ቅንጣት አባባ\nበተግባር እናት በዓዳጁ ተለሳ\n  ፍሬ እንደኛን\nክ አታካቸውም በሰማት ልብን\n  በነጋ በብዛት ፥\nሰከላ አይደለችም\n ትንጣቲቱ አበባ\n ወለና ረጅ የቀመል ወለባ ፥\nየሣለ ውነት ድምቀት\nግን የክም ትርኲ ሥን ገላ ።\nይልቅስ አለው ናት",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
