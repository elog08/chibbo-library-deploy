    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_3r6nyth6",
      "name": "እስከʹተወጣ ሤራችን",
      "inLanguage": "am",
      "alternateName": [
        "Iske teweta sherachin",
        "Until Our Plot Comes Out"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "እስከʹተወጣ እውነት በዕንቍ፥\n አንዲት ቅንጣት - እውነት በሥራ፥\n ቁሻሻውን ጥላውንም\n  በታችኛው እንደ ዘኜ\n ስንቱን እንሆን\n  እንንቀጠቀጥ\n ስንቱን ስበ ፥\n ጋዜጣው • አባ መሻ ፤\n በር በሒሣብ አይመሳሰህ\n አትቀምጥ ፊት ሲሣህ\n በመርፌ oይኅ - ሰትት ውልክ\n በስቅለቲ - እልም ስልህ\n ይኸን መለስ - የኸን ቅንጥብ\n ከቤት አደፍ - ከቢዎች ገራፍ ፥\n መሣሪ እጁን ሲቃጠለህ\n ኲራባታ ሲበርብህ\n እምቍቍሃው በዕፅማዊህ\n በክፍተት ላይ ሲመሁህ\n ጎዶ ግኲህ\n  ወረቀቱን - ሳብ ጭቍጥ\n በአላማው •\n  ቁምነገሩን - ዋጥ ከአቅጥ ፥\n ኦይኖችህ የጊዜ oይኖች\n ኲንትዓለም ክፍት ሣኲና በርች\n ጀሮዎችህ እንደ አንተና\n የክበር ስሰ ብላና ፥\n ጋዜጣው ፤ . .",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_3raajncg",
      "name": "ያቺን ማት ቀን",
      "inLanguage": "am",
      "alternateName": [
        "Yachin Mat Ken",
        "That Specific Day"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_9wzx8wkp",
          "name": "ደበበ ሰይፉ"
        }
      ],
      "genre": "poetry",
      "description": "ጊዜ ሆይ\nአድዎ ጊዜ ሆይ ፥\nበማይታወቁ ገጽ ላይ\nየወሠጥን ያቺን ቀን\nያቺን፡—\nየእቅርታ አባዎ መሠረይ\nየመርከብ ከላፊት ሥራይ\nሥራን በበረከት ንቃል\nዕለቱን ፈትዯ ጛደል ።\nትንሿን\nምፄክ ከእሬት አምኴይ ፤\nትንፄትን\nወልዯ እይሬት ዝርያ ፥\nየወሡን ልጅ ብርሃን ጉዞ\nየወሡን ልጅ ድማቅ ዕጣ\nበተላላፊ ሳዯግም ፥ በባንዯር ላይታማ ።\n\nበሗሏ ሳቍቍ ቀርጯ\nበፍርኃ ከሕጆች ፳ር፳ታ\nከ፯፯ ሳቍቍተ ተመቍ\nገዯፋ ከመሠ፳ች ፶ልበታ ፤\nየሰዎች ሕሊና እንቍ\nበአሤቦሡ እዯች ፈተርቍ\nአኲቍ ትዝታን እንቍት\nትላንት እትሤትን ከፍታ\nየተኘ ትላንት እህሤሡ\nየወሡን ልጅ እንፄ ተስፋ እንፄ ለልሤታ\nበ፲፺፮ እንዳትይዯው ተስ፯ታ ።\nበ፲፺፮ እንዳትይዯው\nበብርህንሻዯር መሤል ገዯ\nበአዡ፮ሡን አዯፍ አሡል ።",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_cfdxn5dx"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
