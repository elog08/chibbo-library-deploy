    {
      "@type": "Book",
      "@id": "https://chibbo.app/work/wk_c00x7vrp",
      "name": "ሞት ለሞት መሞቱ",
      "inLanguage": "am",
      "alternateName": [
        "mot lemot memotu"
      ],
      "author": [
        {
          "@type": "Person",
          "@id": "https://chibbo.app/person/pe_tkbf97dx",
          "name": "ዮሐንስ አድማሱ"
        }
      ],
      "genre": "poetry",
      "description": "እንዴት ያሳዝናል፥ ሞት ለሞት መሞቱ፤\nአፈሩን መቅመሱ፥ ከሆነበት ሀብቱ።\nሰው ለሰው ሲገድል፥ ሞት ለሞት ሲሞት፤\nደግሞም ለመቃብር፥ የመቃብር ሥልት፤\nታሞ እየሞተ ሳይ፥ ይኸን ሁሉ ዓመት፤\nእጅግ እያዘንኩም፥ መሬት ለመሬት፤\nሰው ለሰው ተማሰ፥ ወትሮ እንዳየሁት።\nዕንባ ለዕንባ ሲያለቅስ፥ ልብ ለልብ ሲያነባ፤\nዐይን ለዐይን ሲያዝን፥ ፈጥኖ ተደረባ።\nዕንባዬን ዕንባዬ፥ ሲያጽናናው ቆይቶ፤\nመንፈሴ ለመንፈስ፥ ልቅሶውን አካቶ፤\nዐይኔ ለዐይኔ አዘነ፥ ይኸንን ገምቶ።\nግና ያ መቃብር፥ ለመቃብር ብሎ፤\nአፈር ላፈር ሂዶ፥ አፈር ላፈር ግሎ፤\nሞት ለሞት ሲገነዝ፥ ሰው ለሰው መማሱ፤\nቋሚው እጅግ በዝቶ፥ የሞተው ማነሱ፤\nሥጋ ስትለመልም፥ አፈር መበስበሱ፤\nይኸ እኮ ነው ኑሮ፥ ሞት ለሞት ሲሞት፤\nእየበዛ ሂዶ፥ ፍጥረት ለፍጥረት።\n1952 ዓ. ም.",
      "partOf": [
        {
          "@type": "Book",
          "@id": "https://chibbo.app/work/wk_ftnfn2xa"
        }
      ],
      "usageInfo": "http://rightsstatements.org/vocab/UND/1.0/"
    },
