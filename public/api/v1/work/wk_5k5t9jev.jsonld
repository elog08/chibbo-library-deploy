   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "የብርሃንነት ምpreconnect\nየፍርሀት ግሳንግስ፥\nበበረዶ እጅ ሲደሰኝ፥\nበልብህ ጥቀቚ ሲሰጥህ፤\nምሳለ ክንፈን ሰብሰብ\nዐይነ ሕሊናን አድስ\nከመታመቅ ከወለፈ\nከማቴ ከሰመሬ፤\nሲንግል ከማሰበ ከክክብ፥\nየብርሃንነት ምpreconnect\nየፍርሀት ግሳንግስ፥\nእንዳልተለ ፈረሰ ሲደረቅኝ፥\nእንደ ጹፈት ውኃ ሲያኝነኝ፥\nእንደ ተገለወ ሐሡት ሲሰበርኝ፤\nአለ ፥ በርኅራኄ በል የሚለን፥\nለዐይኔ እንኲን አፍሳ\nበምሳለ ምሬትን ካልሳ\nማቀትን በባህር አላካልሳ፤\nከሞኝነት ቆልት ጨርፍ\nከቅሬ ሕንፃ መለፍ\nየሥውርም ስንኝም ጨምፍ\nከውነት አንሣ ስንቚ\nቀሡት ደሙና አርቅቆ\nበርኃ ፥ ጤና በል አማለኝ\nአለ ፤ አማይስተማለኝ ፤\nየብርሃንነት ምpreconnect\nየፍርሀት ግሳንግስ፥\nበበረዶ እጅ ሲደሰኝ፥\nእንደ ጹፈት ውኃ ሲያፍኝኝ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "እለ ጤና በል አማለኝ",
 "partOf": [
