 "@type": "Book",
 "alternateName": [
  "Iske teweta sherachin",
  "Until Our Plot Comes Out"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "እስከʹተወጣ እውነት በዕንቍ፥\n አንዲት ቅንጣት - እውነት በሥራ፥\n ቁሻሻውን ጥላውንም\n  በታችኛው እንደ ዘኜ\n ስንቱን እንሆን\n  እንንቀጠቀጥ\n ስንቱን ስበ ፥\n ጋዜጣው • አባ መሻ ፤\n በር በሒሣብ አይመሳሰህ\n አትቀምጥ ፊት ሲሣህ\n በመርፌ oይኅ - ሰትት ውልክ\n በስቅለቲ - እልም ስልህ\n ይኸን መለስ - የኸን ቅንጥብ\n ከቤት አደፍ - ከቢዎች ገራፍ ፥\n መሣሪ እጁን ሲቃጠለህ\n ኲራባታ ሲበርብህ\n እምቍቍሃው በዕፅማዊህ\n በክፍተት ላይ ሲመሁህ\n ጎዶ ግኲህ\n  ወረቀቱን - ሳብ ጭቍጥ\n በአላማው •\n  ቁምነገሩን - ዋጥ ከአቅጥ ፥\n ኦይኖችህ የጊዜ oይኖች\n ኲንትዓለም ክፍት ሣኲና በርች\n ጀሮዎችህ እንደ አንተና\n የክበር ስሰ ብላና ፥\n ጋዜጣው ፤ . .",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "እስከʹተወጣ ሤራችን",
 "partOf": [
