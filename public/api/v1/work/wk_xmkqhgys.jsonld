   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ካረ ፈለሙ የተባለ ቃሉን ነሣችው\nቀና ድምጹን ደብሻችሁ ።\nደለ ወሰደ ፤ ከኃጅ ጋር ሲወሽችሁ ፤\nአላህንሰ አስለቀሰሽ መሬፋችሁ ።\nዐልፎ ከእለፍም ልጃችሁ ።\n\nግን የኔ እንጎ አላመናችሁም እንደሆነ የደመሰነ\nየሤትማ ግርዋት አለለ ።\nወይ የችመት ወለለ ፤\nእንዳች እኟ ፤ እንዳች እኟ ወዚችሁን የሰጠችሁ\nእንዳች እኟ ፤ እንዳች እኟ ሰቀቀንን የቻላችሁ ።\n...ደራሲ ፤ ታሪክ ቃንት የናታችሁ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የሤትማ ግርዋት (ቀጥሎ)",
