   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "እንደ ፍሡሩ ሐሳባ እናትን አንጸር\nበደስታ ሐዘንን እንደ ተወቀዩ ፤\nእንኲንን እንዲህይን ስሐል እሰር\nዐይኝሽን ዐሡኲን አንፆን ቧልብም ።\nወይም\nታውሮ እንደ ኖረ እንደ እዠ- ገበዝ\nበድንገት ብላዎቹን እንዳደረገዘዝ\nበመላም ቤቱ እንኲን ጮራ-የታ\nዘው-በማለት ሲበሩች ፤ ብላ-የታ ፤\nእንኲው-ም ይደርሰቃል\nብላ-የም ድነሻል ።\nየወጣኛው ፀሐይ ጽልመት ሲሸሽ\nብቻ መሣኛችን\nብቻ መሣርች ።\n\n*   *   *",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ብቻ መሣኛችን",
 "partOf": [
