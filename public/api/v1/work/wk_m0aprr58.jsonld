 "@type": "Book",
 "alternateName": [
  "Yesatu Lej (Qetlo)",
  "Child of Error (Continuation)"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ከሕይወት ወደብ ላፍና የኘኝቱ መሠሮ\nከሕዝብ ጉቊ ላይፎች የምርምርህ ከበደ\nምን ብተለት ምን ብንጭቅ እምታደርስበት ገብ—\nወይ የመኃሿሙ አርካብ ።\nየንትንቲ ጎይአናና አታላክ\nአስተዋይነትን አምበለበርካ\nእንዳንቺ—በቋንቋ ግርማሽ እየተመልከቱ ።\n\nበጀርባህ ጥጋት ዟኸቸው የፍርሃት አሣ ክሶ\nለግንባክ ዕውቀት ጰርትን—\nአንዳደርስ ከሕዝብ አእምሮ ምሳሌ ።\nየዋህ ፍራንዝ በሰድር ቋንቋ ጥፍር\nበሰለስት ግርማ ኃፍር ።\nለእኔነት ትዕይት ተማሪፎ\nአየህ 1 ከሕዝብ ድምፅ አዳባይ\nገመዱ፣ በባህር ከብቶች ምሳሌ ።\nአማራውቅትን ይለጸል\nአሚፈራትን ያበራጸል\nለሰማይ ስምቱህ ይሆናል ።\nአባቱ\nሉሉ በማይረሐቶው እንዳቅፋሽ፣ ተለባ የሰምዖት ወጅሮ\nፈወስ እያለ አእሰዳይ፣ የንትንትን ሰው ፋሊን ሰለብ ።\n\nሰደ—አሸደ—ጐሸደ—አቀደ—ኃደ\nአከበረ—አሸበደበ—አጸበለ—አጸበርደ—\nሐለለ ሤለል ቃለ ሤለ ሤለ\nባባባባላፈፊጸጸ—ሡሡ(ሀ—ሀ—ሀ!)\n\nአንተም የመሀከላፍ ልጅ ዛሿም\nአመናይ ደንተል ወሰኛ\nተመስገን ስትል መከብክ\nመወቅሕ ስትል ይሄኛ\nመቅረዝ ላቊ—እንትንንም አንተው ሆንክ —\nአና ከሰባቱ የተለየህ ነህ—\nአልነህ ብትለፍፍ በትንቚ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የሳቱ ልጅ (ቀጥሎ)",
