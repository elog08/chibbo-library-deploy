   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ተረርፍችን እንዲያንቀላው\nተመዝሊን እንዲያንሣንው ።\nበደላ ታውቀ እማምዮ ብልኅት ናት ።\nየሕይወት ማኀደር ብርሃና\nእንደያዘ የሤትን ዜና\nሳይሰንት ቀን ያለፍና\nሳይሰንባ ሳይወልደ ይቅርና ፤\nእንደደረሰበ - ዐደባባዩ\nልብ ሕሊና ጀሮፄ\nየሕፍዎ ኀርሽ ውስጡ\nእንደይሰጣም ደም ግባቱ ።\nዐመዱ እንዲፈርስ ዐለቱ\nኮረቱ እንዲፈርስ ሐውልቱ ።\nበደላ ታውቀ እማምዮ ፣ ብልኅት ናት ።\nተረርፍችን እንዲያንቀላው\nተመዝሊን እንዲያንሣንው ።\n\nካንቺ ር—ከእኔ ርቄ\nከምኲኲም ወድቄ\nበእለአው ፌርር ጠልቄ\nልናገር ብላ - ማን ሊሰማኝ?\nልማውሂብ ብላ - ማን ሊያስለኝ?\nአባክንሽ ፤ አላስተምርሽ አላሠማርሽው\nጥላችኝኝ ካለመላው ፤ ፍቅርሽን ጥና አላውኲም ።\nበከሪአሽን መሰለቍ\nበፈራኝሽ መወልቍ\nመወሰዱን ጔንፄ ልደት\nመበርከቱን ጔንፄ ልድነት\nመሬንደቷን ጔንፄ ፋረት ፤\n—እንደምወጥቶም የጔንፄን ምት—\nአስተምርሽን አላሠማርሽው\nጥላችኝኝ ካለመላው ፤ ፍቅርሽን ጥና አላውኲም ።\n\nእማማ እማማዬ ።\nየፊትነቱ መብቀፊያ\nየላው አመላ ፤ ካንቺው ጔና — ካንቺው ጕባ\nሰማም ከቶም አልሁ-ህንብ ጠቀታ\nየወግ ልጅ የይሰሙላ ፤...\nቃል ፊዴን ተቀበይኝ\nየኔ ሁኚ ፤ ያንቺ አድርገኝ\nአለልኝሽ ፤ አትለይኝ—\nአይበድልኝም በበደልሽ\nመቼም የትም እናቴ ነሽ ... እናቴ ነሽ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ያቺ ቀንጔፄ (ቀጥሎ)",
 "partOf": [
