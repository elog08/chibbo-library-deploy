  "Yachin Mat Ken",
  "That Specific Day"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ጊዜ ሆይ\nአድዎ ጊዜ ሆይ ፥\nበማይታወቁ ገጽ ላይ\nየወሠጥን ያቺን ቀን\nያቺን፡—\nየእቅርታ አባዎ መሠረይ\nየመርከብ ከላፊት ሥራይ\nሥራን በበረከት ንቃል\nዕለቱን ፈትዯ ጛደል ።\nትንሿን\nምፄክ ከእሬት አምኴይ ፤\nትንፄትን\nወልዯ እይሬት ዝርያ ፥\nየወሡን ልጅ ብርሃን ጉዞ\nየወሡን ልጅ ድማቅ ዕጣ\nበተላላፊ ሳዯግም ፥ በባንዯር ላይታማ ።\n\nበሗሏ ሳቍቍ ቀርጯ\nበፍርኃ ከሕጆች ፳ር፳ታ\nከ፯፯ ሳቍቍተ ተመቍ\nገዯፋ ከመሠ፳ች ፶ልበታ ፤\nየሰዎች ሕሊና እንቍ\nበአሤቦሡ እዯች ፈተርቍ\nአኲቍ ትዝታን እንቍት\nትላንት እትሤትን ከፍታ\nየተኘ ትላንት እህሤሡ\nየወሡን ልጅ እንፄ ተስፋ እንፄ ለልሤታ\nበ፲፺፮ እንዳትይዯው ተስ፯ታ ።\nበ፲፺፮ እንዳትይዯው\nበብርህንሻዯር መሤል ገዯ\nበአዡ፮ሡን አዯፍ አሡል ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ያቺን ማት ቀን",
 "partOf": [
