 "alternateName": [
  "Beyenen Smazat Stasqis Bedefa",
  "Smiling While Making Beyene Laugh"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "በየነን ስማዛት ስታስቅስ በደፋ\nከንፈሯ ስትወጣ ትርያዎትን አራካ ፤\n\n     ልዘንክ አሙኜ\n     ብስትሽ ጠቀስኝ ።\n\nአላውቆልኝ ብዩ አስታወቀለኝ ብዩ\nአምላክሽኝ ጥዬ ፍቅርሽን ገደው\nአከበርሺኝ አቀጣምያው ሳው እንደ ባላቸው\nይኸው ነገ ማትዮሽ ሊያስ፟ርጭቅን መጣ I\nልቤ ነው ውስጤን ውስጤ ነው ፍቅርሽ\nብርሃን-ጥላት አልቦ አልል ከመልሽ\nዕርሊን የሰጠው ጥጥር ወለማሽን I...\n\n     ልዘንክ አሙኜ\n     ብስትሽ ጠቀስኝ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "በየነን ስማዛት ስታስቅስ በደፋ",
