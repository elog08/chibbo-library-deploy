 ],
 "description": "ትዝታ ከእቱ ነበባል አብቦ\nኑ ድርብት ስሰን ጃይውን አቅርቦ\nየጤፍ የንቺ ልብ መቀት - ከለ ኖሮ ፡\nይኸው የተረፈን -\nቁርና እንትርግር - በመደርሳ አድር\nምቱ ውል የለለው ትዝታ - ክብር ፥",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ትዝታ — ክብር",
