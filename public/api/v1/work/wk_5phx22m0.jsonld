 "@type": "Book",
 "alternateName": [
  "Ye Ef Nege",
  "The Speech of the Lip"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_69k04xse",
   "@type": "Person",
   "name": "አበራ ለማ"
  }
 ],
 "description": "\" ከፍ እፍ አለች እኮ! \"\n\" ማን? \"\n\" አፈ- \"\n\" አፉ በልጉም ይሆናል \"\n\" መቼ ቀንያች ብሉል _ ይህ እንካ \"\n\" እሳሳ? \"\n\" ምኲፉ-ኤ ወዲህ ነው _ \"\n\" ወዲዴት? \"\n\" ተፈጠረው ከድን ሁሉ የእፍ ነገር ነው \"\n\" እንዴት? \"\n\" እንጀ አባቴ! ... እፍ ለምበርት \"\n\" ያፍ ለመል አንዳን እማችኝ? \"\n\" እፍ ኝት አለፈው ሲሉ ስሞፉ \"\n\" እንዴት? \"\n\" እፍ ታልናፍሩት እጻፈ ነው ይባል የለ \"\n\" አበክ እጅግ ነው:: እፍ ያለው ጤፍ ይሻላል \"\n\" እፍን ጠቅም ወርቂት ቅም _ ሲባል ሰባቲ ሠየ ቀዋ \"\n\" ቢሆንም እፍ ያበቃ ! ጥበብ ቃሊ አንደሆነን \"\n\" ቢሆንም እፍ ነገር ! ዐይህን ነገር አይጣም ይባላል \"",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የእፍ ንገር",
 "partOf": [
  {
   "@id": "https://chibbo.app/work/wk_pp1vw4r4",
   "@type": "Book"
  }
 ],
