 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "አሁን አንገት ማን ሊመጣ\nአባቱን መስሎ የወጣ\nአንዲትም ያንቱ ልጅ የል\nጥበብን አፍሮ የጸለ\nአወፍሮ ያሰለና\nአንድም አንትን መሰሎ—አባቱን መሰሎ የሚለ ።\n\nአባቱ\nበማዕዘን አጥር ኃፋግ ሕይወት ቀርሮ\nከመላእክት ጋር ታፍሮ\nከስምዕጀት ተተራፍሮ\nከመናፍስት አባብጥ ጥምሮ ።\n\nየዳርቻ ያህል ተለርፎ\nከዳርቻ ይልቅ ጉልበብ\nአሸለለ፣ አንትን አምሳያ ልጁን ተከትሎ ።\nአባቱ\nየሰገደው ካዝና የምስጢሩ\nሰወር፣ የእንዳቅፋሽ ድርደሩ\nየመደርደቱ ታምር—አህዮ ግብሩ ።\n\"በምድር ላይ የሚመጪ ድምፅ\"\nሐጲን—የሰወይ ቅርጽ\nበእሳት ሉዓን ተናጋሪ\nየመለኮት ቃል ፈጣሪ ።\n\nአባቱ\nሰደረ እሳት ምሳሉ\nአይለድ ጥበብ ቅርጹ\nአይናጥ ምስጢር ውርጹ ።\nደብሰ ያሰለመ—እንትን አደረሰ እምታሰርሰረው\nእግቱን ወለደ አምታውለደው ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የሳቱ ልጅ",
 "partOf": [
  {
   "@id": "https://chibbo.app/work/wk_cfdxn5dx",
   "@type": "Book"
  }
