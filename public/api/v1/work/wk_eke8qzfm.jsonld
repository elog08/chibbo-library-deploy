   "@id": "https://chibbo.app/person/pe_eqyqm5nd",
   "@type": "Person",
   "name": "ጸጋዬ ገብረ መድኅን"
  }
 ],
 "description": "እስከመቼ ይሆኝ አዋሽ? ....\n\nአዋሽ፥ የመጪ ሥር ፋናሽ\n\nየለም አፈርሽ ደሞ ቍናሽ\n\nየሽፕ የአምልኮትሽ ባት፥ የምንጮችሽ ምምጥ አማጭ\n\nየአለታሽ የተለፈች፥ የታልምምዋትሽ ፍላጭ፥\n\nአዋሽ አምሁም ምንድነው? አምላክን አንተም ምንድንህ?\n\nከው-ህ ወደ ተለየ፥ መሻን ልዩ ንግርህ ባለህ\n\nእንደ-ሰቴ ሸራተት ፅንአት ራስህን በራሱህ ዋጥ ባለህ....\n\nእስከመቼ ይሆኝ አዋሽ? ሲሳለደር ሲቆዘዘንህባህ\n\nሳትሃልቀው ሳይሃልቀህ\n\nአሸፕ አለሸፕ ድኜህ\n\nውስጥ ለውስጥ ምኑህ ጠአቁህ\n\nየምድርን ማቱን በርበሩህ\n\nዋልታውን ቀለቃ ስንተሩህ\n\nእናትህ ወይያሰነ ማጥን፥ ሳትገቡ ትግሃነሁህ*....\n\nእስከመቼ ይሆኝ አዋሽ?.... አዋሽ በ-ርቃው፥ መጪ ምኳዬ\n\nዳዳ ፅንአ ሸፕ ፋንኜ፡\n\nው-ሀህ ተው-ሀህ እርስኜ\n\nየንጹሩ የበርሀህ ዕጮህ\n\nንግርትህ ምንድነው አዋሽ፥ አባ ብቻ አባ እቅጩ?",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "አ ዋ ሽ",
 "partOf": [
  {
