 ],
 "description": "ዝዘንባባ የምርት ምስል\nይታደል ወለሉ ዉድ ነበረን\nይስክብር በደስታ ህዝቡ ያሳቅቅ\nድምፁ እየተመታ መlሐቃ ሙሉ ሰናፍቅ\nእንቋጣጣሽ ብለን እንጠዋቱ ሰላምታ\nየዘመኑ ሠሪ የወርፄ ጌታ\nጨጨብሊ ለዛፍህ\nጨጨብሊ ለሰፈርህ\nጨጨብሊ ለመለኮቱ\nአንተ ነህ መስከረም\nዘመን የምታደስ አስከሰሙ በሰላም።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የዘንባባ የምርት ምስል",
