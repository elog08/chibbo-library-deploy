{
 "@context": "https://schema.org",
 "@id": "https://chibbo.app/work/wk_ey1yv4a0",
 "@type": "Book",
 "alternateName": [
  "Gin Yehem Aydellem",
  "But This Is Not Either"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_nx5wyc7s",
   "@type": "Person",
   "name": "አልአክብ አብርሃም"
  }
 ],
 "description": "አንድ ራሱን መሆን\n እየመሳሳቸው፥\n'ብቻኝ ይለኛል\n ብቻ ሳልባቸው...\nእኔ ግን አላለሁ\n ብቸኝነት ማለት፥\nሚሊዮኖች መሀል\n ፲ ሆኖ መገኘት፥\nከሌሎች መወዳደር\n ከራስ መለየት\n ይ ነው - ብቸኝነት !!\n\nግን ይሄም አይደለም\n ለለምለም ቃል ቃል አይደለም፥\nብቸኝነት ማለት በቁ ብቻ መሆን !!\n\nደግሞ በልጅ ዓለም፥\nማንም ከማንም ጋር\n ೧፪ ላይ አይደለም...\nደግሞ በልጅ ጥሮ ተንፍሶ ሲንሳሳ\n ትንሣኤ ውዳቂ ነው ፲፮ ዊት ቀረሳ !\n\nእየተቃቃፈ፥\nእየተቃራመኘ፦\nየፍክንሡ አሡታ በግሩሽ ካልሰመተ...\n\nብርቁ ንኝ እያዩ ሰውነት ከሃለ፥\nድንበር ከናት እውነት፥\nድንበር ጣሽ መክፈት፥\nማለፍ ከከለለ...\n(ማነው - የሚዘራው ?)\n\nእኔ ራሴን ለመውረድ...\n\nራሴን ሳሰበው - ፲ሁኝ ደመመኝ...\n\nጤናችንን ሳሰበው - ጤናችንን አመመኝ...\nዝምታዬን ጨምቅኝ\n ሳቄ አላቀቃ\n እውጤ ፈረሰች፤\nዝጀት ተከፈተ...\nቃል ብቻ\n ሲመስልኝ\n ይሄ\n የኔ\n ጣጣ\n\nአብራሪኝ ነህ ስአልህ\n ድርሀይ ካልሰማ ቃል፥\nአብርነት ይበቃል !!\n\nከምር አላገባሁም\n እዎ አንተ አንባቢው\n አንቺ ይሄን ፈለግ ፈለግ ባይሸኝምታ።\nአስከ ቃል ተጠብተሽ ቃለችን አትማል !\nአጂ አሁን ይሄ ቃል - ይሄ ቋቋል በደል\nበ'ንነት አማርኛ ቁል ግጥም ነው - አይደለም ?",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ግን ይሄም አይደለም",
 "partOf": [
  {
