   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ዛሬ ተመመልሽ በትናንት ተአስየ\nአሮማዊ ፍቅር በእውነትም ገለጸ፡\nድሮውን ቢሆን—\nሰማይና ምድር መቼ ተገናኝቶ—\nመቼ ተሳካሙ ?\nየው አንዲህ አንዲንቲ መለከት አንጂ ዓለሙ።\nበምፍን አትፕዬ በምምት በክልሙ ።\nልብ ቢይ\nእእንቲ ሆይ —\nየፈና የግንኙ ጠቢ እይደለም የርሰ በርሰ\nየልችት አንጂ የራሰ ሥጋ ነብብ\nሰማይ እማወተር ደም የቀን እመላበ\nከራሰ እማያስከብ ።\n\nበዐይኑ ጥራ ታበረካ\nበተራ እሳት ተማረካ\nበ“ምን ዕኑን” ደክመኝ I\nከዚህ የሕይወት ጊፋት\nማኅበራዊ ውርደ\nምድርዊ አመሳሰ መላቀቁን አፕትን I\nየግንባኝ ዋይአ\nየፍክሩን አሡ—ታ\nየቀንትን አራታ መመለስ ኊቃን I\nበጾች ሳንቺዎች\nአፍቻት ልጆች ፤\nለፍቅር ጥንጀዎች\nለወዕቅ አምሮቶች I\nከፍብነት ደወራ\nአበቦት ደራዳ I",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "አሮማዊ ፍቅር",
 "partOf": [
  {
   "@id": "https://chibbo.app/work/wk_cfdxn5dx",
