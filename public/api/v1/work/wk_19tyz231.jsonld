 "alternateName": [
  "Kebalemuwoyat Mahteme Selassie Wolde Meskel Yetezaguju Metsahift",
  "Books Prepared by Expert Mahteme Selassie Wolde Meskel"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_qswkqgta",
   "@type": "Person",
   "name": "ማኅተመ ሥላሴ ወልደ መስቀል"
  }
 ],
 "description": "ከባለሙያዎች፡ ማኅተመ፡ ሥላሴ፡ ወልደ፡ መስቀል፡ የተዘጋጁ፡ መጻሕፍት።\n\n፩፡ ከሐለ፡ ነገር፡\n፪፡ ዕጸ፡ በለ፡ ድንቅ፡\n፫፡ ያባቶች፡ ቀርን፡ (አንደኛ፡ እትም፡) (ሁለተኛ፡ እትም፡)\n፬፡ ጥበብ፡ ባህርታ፡\n(አንደኛ፡ እትም፡) (ሁለተኛ፡ እትም፡) (ሶስተኛ፡ እትም፡)\n፭፡ አማርኛ፡ ትችት፡\n፮፡ እንቃልፍ፡ ለምኔ፡ (አንደኛ፡ እትም፡) (ሁለተኛ፡ እትም፡)\n፯፡ ስለ፡ ኢትዮጵያ፡ የመሬት፡ ምረት፡ አስተዳደር፡ ግብር፡\n፰፡ አማርኛ፡ ትችት፡ ከነመጻፍቸው፡\n፱፡ አማርኛ፡ ትችት፡ ከነመጻፍቸው፡ ተሻሽሎ፡ የወጣ፡\n፲፡ ስም፡ ከመቃብር፡ በላይ፡\n፲፩፡ የእኛም፡ አለ፡ እንወዳቸው፡\n፲፪፡ በዕለ፡ ባህርታ፡ (በመዘጋጀት፡ ላይ፡ ያለ)",
 "genre": "essays",
 "inLanguage": "am",
 "name": "ከባለሙያዎች ማኅተመ ሥላሴ ወልደ መስቀል የተዘጋጁ መጻሕፍት",
 "partOf": [
