 "alternateName": [
  "Nite New",
  "It is You"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_w3mte77q",
   "@type": "Person",
   "name": "ዓለም ፀሐይ ወዳጆ"
  }
 ],
 "description": "ንተ ነው!\n\nከሰወ፡ ርቀ የምፍለውን፡\nበከተማ የማውለለውን፡\nዳልባችንን የማየንቀውን፡\nዘኘ ነቩ የማስተንቀው፡\nቤቶቻችን ይቆይ ነቩ . . . ንተ ነው!\nባለስምዑን የምግምለውን፡\nአይቻለውን የምችለውን፡\nየሆነውን የምክየዶውን፡\nከሰው፡ ከነት፡ የምርዶውን፡\nንተ ነው! . . . እንተ እንደተወደው፡\nየማልፈራውን የምፈራውን፡\nአቀቍቀ፡ የማወለውን፡\nሰላምን እንዳላማ\nደሞ  ጭፍጭፍ እንዳይመጣ\nእንተን ነቩ ነው ደስ እንዲአሉ\nከግሬ በቀን እንዲየሞልብህ\nየጠሰኘውን መለቩ\nየወደሰነውን በለቩ\nየምይደመውን የምፍለውን፡\nየምነካው የምነዶውን፡\nልቤን ትዕግስቱን የምቆው፡\nልጆች እይበትች ነቩ\nንተ ነው! . . .",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ንተ ነው",
 "partOf": [
  {
