   "@type": "Person",
   "name": "አሌክስ አብርሃም"
  }
 ],
 "description": "ይህ የኔ ምሬት፥ የኔ የፍቅር ድምፅ፥\nላንተ የምገምተው ጥፍር ነው ... እስካሁን !\n\nአልገባሁም አይደለም የኔ ፈደል፥\nአሁን ላይ ነበር አብርችን መዋደል !\n\nግን ይሄም አይደለም...\nለላም ቃል ቃል አይሆንም\nበኛኝነት ማለት በቃ ብቻ መሆን !!",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ይህ የኔ ምሬት",
 "partOf": [
