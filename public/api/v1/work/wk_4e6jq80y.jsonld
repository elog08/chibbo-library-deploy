 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ብርኀይቱ ጨረቃ\nየብርኀይን ጠበል አፍልቃ\nተፈጥሮን ስታምምቀበት\nእንደገና ስትወልዳት\n       ኃፋር በቀንቍ\n       በበረደ እጁ ጔማች ፤\n\nአዴ ሳንቆ\nወሩን ከወሩ አዝደሞ\nያስተውላል እንደ ነገ\nአሽፋፋኰ ከሥሩ\n       እንደ ሤበት\nአደራሤት የቆመበትን\nየሤነት ።\n\nቆን ይለናል ዐለደ ዐለደ\nለአዴ ሳንቆ\nእየታደረ ነው ቀቍሮ ፤\nበቅበ የመኒመውን\n       በለኀውን\nግለት እንደ ማደርገ ማር\nሆንኳ እያደርገ ማለ —\n       ማሉን ነው\nጥላት እንደ ማደርገ ቪለሰ —\n       አለውን\nአልደ ተወው\nበእር ድህን ሲደርርው ።\n\nከዝም ታወ ... ታወ በ፲፲ሮ\nእንደ ደግ አካም ደሳ ደሳ እያለው\nሦስተም ማለቶች ሲሰመመሙ\nየሰውን ፲ርበር ሲሰማቍው ።\n\nበልብ አደመው ሲመጣ\nየየንሤን ሤብ ደርሰ ደርሰ\nሿቍበ ሿቍበ",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "አዴ ሳንቆ (አንድ የሰራም ወንድ)",
