   "@id": "https://chibbo.app/person/pe_7t8990dd",
   "@type": "Person",
   "name": "መንግሥቱ ለማ"
  }
 ],
 "description": "ጉደኞ፡ ደህና፡ ሁኑ፡\nአደማችሁ፡ አይረገርም፡ እንደነኃችሁ፡\nእንደዚህ፡ ባንድግዜ፡ የመህረጃችሁ፡\nትንቍትን፡ አንነት፡ መች፡ ተለያችሁ፡\n—አንድ፡ የፍቅር፡ ቀንደ፡ ስሰማችሁ፡\n\nቀንደውም፡ ያለነፍሳ፡ ጸዋ፡ የነበረ፡\nበእንድ፡ ሐቍር፡ ጸሐይ፡ ከው፡ እንኃል፡ ቀረ፡\nለፍሰው፡ እንኃልህ፡ የፍቅርህን፡ ጥላፍ፡\nካልተገኘች፡ በቀር፡ የምትቍጣር፡\nየነኃትን፡ ተራራ፡ የሰበሰ፡ ፳ጀ፡\nሊተንተከ፡ ያልሰኲት፡ ያልተማረች፡ ልጅ።\n\nቍጥምና፡ ትቅመሰው፡ ያን፡ መ፲፡ ማር—ወሰላ፡\nያን፡ የቅኔ፡ መጠጥ፡ ያን፡ የጐንደር፡ ጠላ፡\n—ሬዲ፡ ላይ፡ ሲወጣ፡ ትንጐ፡ አይላት፡\nገሡቱ፡ ብቻ፡ ነው፡ የተሣሣተ፡\nጐሽቍምም፡ ቀርቷል፡ ጠላ፡ በሙርጯቱ፡\nአምር፡ አፄ፡ የመሰል፡ ቃውምም፡ ከንቱቱ።\n\nቤተክርስቲያን፡ ስትሰመ፡ በማቲ፡ ጯጯት፡\nþጅባችሁ፡ ድንገት፡ ስንለው፡ ሟተት፡\n«ጤና፡ ይሰጣችኝ» መቼም፡ መባባል፡ አይቀር፡\nብርቱ፡ አንነት፡ ሁለ፡ ምን፡ ሲያደርደር፡\nአናቴቱ፡ ዳር፡ ከፍ—ቀፍ፡ ስትል፡",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ጉደኞ ጻማዊ",
 "partOf": [
  {
