 "@type": "Book",
 "alternateName": [
  "eshkelekenta weyem yeenba sheleqo"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_tkbf97dx",
   "@type": "Person",
   "name": "ዮሐንስ አድማሱ"
  }
 ],
 "description": "እስካጊዜው ድረስ፥ እስኪሞላ ልኩ፤\nአልቦ ሁኖ እስኪቀር፥ ዓለም መመለኩ፤\nእመለከታለሁ፥ ሁሉን በየመልኩ።\nእስካጊዜው ድረስ፥ እስከ መቃብር፤\nሲቀር ለሚቀረው፥ ለምን ልገደር፧\nመጓደድ አይረባው፥ ኑሮ እሽከለኬንታ፤\nሁኖ ለሚቀረው፥ ከንቱ የውኃ ሽታ።\nሳሰላስል ሳስብ፥ ሳወጣ ሳወርድ፤\nበሰው ተገዝቼ፥ በሰው ስሰደድ፤\nየሌቱ ዘለሳ፥ የቀኑ ግሥገሣ፤\nተኝቼ ቢሆንም፥ ወይንም ስነሣ፤\nአብሮኝ የሚተኛ፥ አብሮኝ አንጎላጅቶ፤\nሥግው ሊሆን በኔ፥ ባካላቴ ገብቶ፤\nይኸው ይታየኛል፥ በዐይኔ ሕሊና፤\nየሰው የበህር ልጅ፥ ክፋት ሁሉ መና።\nከጥንት ጀምሮ፥ ፍጥረቴ ላሣር፤\nለመከራ ትካዝ፥ ደሞም ለችጋር።\nከጥንት ጀምሮ፥ ሕይወቴ አሬዎና፤\nመቃኛ የሌለው፥ የጽልመት ጎዳና።\nጥራትና ውበት፥ ከሌለው መኖሬ፤\nይሻለኛል እኔ፥ ፈንታ መቃብሬ።\nቡንኝ ትቢያ እንጂ፥ ነው የኔ ገላ ፀፈር፤\nልቤ እየተረዳው፥ ይኸንን ሲኖር፤\nያለሁበት ዓለም፥ ፈጽሞ ለምኔ፧\nእሽከለኬንታ ነው፥ አይረባኝም ለኔ።\nየሕይወቴ ወረት፥ እንዲሁም ድላሉ፤\nኃዘን ትካዝና፥ ጥቃት ነው በሙሉ፤\nይኸ ሁሉ ሲሳይ፥ ይኸ ሁሉ አዱኛ፤\nየሕይወቴ ተስፋ፥ ያካሌ መጽናኛ።\nእረ ሰውስ ሲባል፥ አስጠላኝ ፈጽሞ፤\nጥሎ የሚነጉደው፥ አንጋሎና አጋድሞ።\n\nበሰዎቹ ምክንያት፥ በሰዎቹ ተርታ፤\nጠላኋቸው እጅግ፥ ሆንሁኝ አማጎታ።\nሰው ኮሶ ብጠጣ፥ በጅጉ ደቁሼ፤\nፊትም አስቀድሜ፥ ጥቂቱን ቀምሼ፤\nገብቶ አያስቀምጠኝ፥ እንዲያው መቁረጥ ብቻ፤\nፈጽሞ አጣሁለት፥ መላ መቀነቻ።\nአየ የኔ አዱኛ፥ አየ የኔ ዕድሌ፤\nታዞረኝ ጀመረ፥ ከቶ ያላመሌ።\nይህች እመቤት ዓለም፥ ባለብዙ ቤት፤\nእልፍኝ ታዳራሽ፥ ማድቤት ተማጀት፤\nለኔም ሰጥታኝ ነበር፥ አሠርታ ተግታ፤\nእልቅሶ ማጀትን፥ አድርጋ በተርታ።\nመቃኑን ጉበኑን፥ በወግ አሳልቼ፤\nመጽናናትን ቤቴን፥ ፈንታዬን ሠርቼ፤\nሣርና ቅጠሉን፥ ደርቤ ለብሼ፤\nዛፉን ተጠግቼ፥ ደንጊያ ተንተርሼ፤\nበዕዝነ ልቡና፥ በመስማት አንጽሬ፤\nየደኑን ጸጥታ፥ የወፉን ዝማሬ፤\nውኃም እየጠጣሁ፥ በጆቼ ጨልፌ፤\nከሰዎቹ ተራ፥ ከዘረን አልፌ፤\nእስኪ እሞክራለሁ፥ ለመኖር በጤና፤\nርቄ ወጥቼ ከዚህ፥ ከሰው ዓለም ከዚህ ከንቱ ወና።\nእስኪ ሰውነቴ፥ የኔ ገላ ዐፈሩ፤\nእንዴት አደረገህ፥ ዓለም ቤት ያሣሩ፧\nገና ለጋ ነበርሁ፥ ከለጋም ቀንበጥ፤\nየዚህ ዓለም ሰዎች፥ ያወጡኝ ከቅጥ።\nየዕድሜየ መጠኑ፥ ገብቶ ቢሆን ኑሮ፤\nአይጥለኝም ነበር፥ ሰው ሁል አስመርሮ።\nእረ ለምን ሆነ፥ ሰው ሁሉ ሽመላ፧\nአርሶ ያልዘራውን፥ ለቅሞ የሚበላ።\nየቅጠሉን ሁሉ፥ ያበባውን ሽታ፤\nእቀመጣለሁኝ፥ አሽትቼ በተርታ።\nበብቸኝነቴ፥ ምፈጀው ዘመኔ፤\n\nምዑዝ ነው፥ ሐዋዝ ነው፥ ዕጹብ ነው፥ ግሩም ነው፥ ዙሮ ዙሮ ለኔ።\nንቡም ሆነ ወፉ፥ አንድነት ሲተም፤\nሕይወት ነው ለነፍሴ፥ ለልቤ ፍጹም።\nይበጃል ምዑዝ ነው፥ ይሻላል ሐዋዝ ነው ከነዚህ መኖር፤\nለተመለከተው፥ ለሚመረምር።\nሕይወታቸው ሁሉ፥ ተግባራቸው ሁሉ በመላ ጥበብ፤\nውበት የጸነሰው፥ እያሸበረቀ ፈጥኖ የሚያብብ።\nተንትኜም አየሁት፥ በሕሊና አንጽሬ፤\nሰው የሚባለውን፥ ይኸን ታላቅ አውሬ።\nላይሰማው ለሱ፥ ላይታወቀው ግብሬ፤\nላይታየው ጥቃቴ፥ ላይጠፋ ችግሬ፤\nየጥቃቴ ጌታ፥ አባረረኝ ዛሬ፤\nከዚህ ጽልመት ዓለም፥ (ይኸም ዓለም ሁኖ) ኑሮው ምዝባሬ።\nደቁሼና ልሜ፥ ከቶውን አልግት፤\nበጥብጬ አላጠጣ፥ ለሰው ልጅ ዕውቀት።\nይኸ የሰው ገላ፥ የጥላ አከላት፤\nይኸ የሰው ገላ፥ የሕልም አከላት፤\nየቀትር ደመና፥ ሲበተን ቅጽበት፤\nአቅድ የለው የመኖር፥ የህላዌ ስልት።\nበሕይወቴ ውኃ ውስጥ፥ አለበት አልቅት፤\nአልቅቱም ክፉ አልቅት፥ የሰው ሰውነት።\nየኔኑ መከራ፥ ኃዘኔን ብሶት፤\nእስኪ መዘን አርጉት፥ እስኪ ቅመሱት።\nተሰፍሮ ነበረኝ፥ (አሁንም አልጠፋ፥ መጥፋቱንም እንጃ) እህሌ ኃዘን፤\nበታላቅ መሥፈርሪያ፥ በትካዝ ላዳን።\nእስኪ ይከፋፈል፥ ለፍጥረት አሁን።\nየልቤ ቅዘዙ፥ የልቤ ትካዙ፤\nመሥፈርት መጠን የለው፥ ጉድ እንጂ አበዛዙ።\nመከራ ተረግዛ፥ ተወልዶ ችግር፤\nሥቃይ ተሞሽራ፥ ሲዘፈን ባገር፤\nኃዘን ስትዘፍን፥ አታሞ ስትመታ፤\nድህነት ሲሸልል፥ እየነፋ እንቢልታ፤\nረሀብ ሲያቅራራ፥ በጣለው ሰለባ፤\n\nቀጠና ደረሰ፥ ድምጹ እያስተጋባ።\nቡትትም አጊጣ፥ ከድሪቶ ጋራ፤\nዝተትና ማቅም፥ ሁነው በየተራ፤\nመጡ ከኔ ዘንዳ፥ አብረውኝ ሊኖሩ፤\nተስማምተው ደረሱ፥ እየተባበሩ።\nየኒህን በኔ ቤት፥ መስማማት ጠይቆ፤\nፈልጎ ቦታውን፥ ገቢሩን አጥብቆ፤\nገስግሶ ደረሰ፥ ብሎ ከንበል ደፋ፤\nተፋጥኖ ጥቃትም፥ ከሰዎቹ ተራ ተሰማ በይፋ።\nቡትትና ኃዘን፥ ማቅና ችጋር፤\nድሪቶና ሥቃይ፥ ተስማምተው በፍቅር፤\nዝተት ከድህነት፥ ሥቃይ ከቀጠና፤\nረሀብ ተምንዳቤ፥ በመዋደድ ቃና፤\nመከራና ጥቃት፥ በሰልፍ በተራ፤\nተጫጭተው ተስማምተው፥ እየመቱ ሤራ፤\nሠርገው ተጋቡ፥ እጅግ ተደሰቱ፤\nከዚሁ ከኔ ቤት፥ ገቡና በለቱ።\nእነዚህ ወለዱ፥ ወልደውም ተባዙ፤\nይኸንን የኔን ቤት፥ ፈጽመው ሊገዙ።\nልትቧግት ብትሄድ፥ ችግር እጅግ ፈጥና፤\n\nማጣት ይዛ መጣች፥ ደርሳ ከጎዳና።\nኃዘንም ብትነግድ፥ ከመከራ ጋራ፤\n\nልቅሶ ይዛ መጣች፥ አትርፋ በመራ፤\nትካዝና ብካይ፥ በተራ በተራ።\n\nሥቃይ ብትቆፍር፥ ረሀብ እየዘራ፤\nቀጠና ባንድ ፊት፥ ቢያዘምር አዝመራ፤\nእጦትም ሲያካብት፥ ከሰቀቀን ጋራ፤\n\nድሪትና ቡትት፥ ንጣትን ሲቀዱ፤\n\nዝተትና ማቅም፥ እየተረዳዱ፤\n\nምንዳቤም ፈንታዋን፥ እንጨት ስትለቅም፤\nክሳት ይዛ መጣች፥ አመረተች ፍም፤\nክሳትም ነደደች፥ መመንመንን ይዛ፤\nድህነት አንዳጁ፥ ጥቃት እጅግ ለዝዛ።\nጠግቦም እያደረ፥ እየበላ ሥጋ፤\nከኔ ጋራ ኖረ፥ ይኸ ሁሉ መንጋ።\nእንዲሁም በፈንታው፥ በሽታ ሊያበላ፤\nቤቴን ወጥቶ ሄደ፥ እየመታ መላ።\nቧግቶ ወጥቶ ወርዶ፥ ከጥኋት እስከ ማታ፤\nሰውነቱ እስኪርድ፥ እጅግ እስኪፈታ፤\nከሞት ጋራ መጡ፥ አብረው እያወኩ፤\nይኸንን የኔን ቤት፥ መጠኑን ሊለኩ።\nአይተው ገመቱና፥ ሁሉም ተስማምተው፤\nመከረኛ ቤቴን፥ ጠባብ ነው ብለው፤\nሠሩልኝ አንጸው፥ እኒሁ ኬውነቱ፤\nአዳራሽ መቃብር፥ ሚሆነኝ ለለቱ።\n(እንዲሁም ያሰፊ ቤት፥ ድንገት ተገኘና)\nጥቃትና ችግር፥ ፈጥነው ተጋቡና፤\nከድህነት ጋራ፥ እኔን ፈጥነው ወልደው፤\nዳሩልኝ መከራ።\nወንጭፋ ወንጭፋ፥ ጣለችኝ ምንዳቤ፤\nእንደዚህ እስክቀር፥ ተስቤ ተስቤ።\n\nደረቴን ሸርሽራ፥ ገብታለች ከልቤ።\nእስኪ ሁሉ ይግባው፥ ይሰባው ኃዘኔ፤\nተንግዲህስ ወዲያ፥ አልገኝም እኔ።\nዕንባዬ ሲቀዘፍ፥ ኮለል ብሎ ካይኔ፤\nበነበርሁበቱ፥ በመላ ዘመኔ፤\nነቅቶ እየመነጨ፥ ከምንጩ ከልቤ፤\nመያዙ ቢሳነኝ፥ ከትሬ ገድቤ።\nምንኛ ይጠና፥ ይህ ዐፈር አካሌ፤\nእንደዚህ ሲበላው፥ እንዲህ ሲመያስኳው ክፉ ብልባሌ።\nምንድን አፈለቀው፥ ይህን የኔን ዕንባ፧\nስሜቴን ገላዬን፥ ሽርሽሮ ደነባ።\nየሰው ክፋት ሸሩ፥ ተንኮል ንዝንዝ፤\nገላን የሚያረጥበው፥ እያበሽቀጠ ልብን የሚያለዝ።\nየክረምቱ ሰማይ፥ የኔ አካል ሕሊና፤\nኖረ ተሽፍኖ፥ በግፉ ደመና።\nአመጣበት ጽልመት፥ የጥፋት የክፋት የተንኮል ጋዘና።\nየኔማ የኔ ልብ፥ የኔ ልብ መዓልት፤\nየሰው ክፉ ሥራ፥ ጽልመት ሸፍኖት፤\nወጨፎው ዕንባዬ፥ ወጀቦው ሲወርድ፤\nበደመናው ፊቴ፥ መብረቁ ሲነጉድ፤\nሕይወቴ ነገለ፥ ጠፋ ተሸርሽሮ፤\nሰውም አፈሰሰኝ፥ ካለም ውስጥ አንቅሮ።\n\nበሰው ምድጃ ነው፥ ዕንባዬ ውኃው፤\nበጥቃቱ እሳት ላይ፥ ነፎ የፈላው።\nእጅግም ነፈረ፥ በጣሙንም ፈላ፤\nአገንትሮ ፈጀው፥ ይኸን የኔን ገላ።\nሕይወቱንም ጠላው፥ ጠላው ሰውነቴ፤\nመኖሩንም አብሮ፥ ደግሞም አከላቴ፤\nአመሳሶ በዝቶ፥ በየቀበሌው፤\nየኔኑ ሰውነት፥ ጠበሰው ፈጀው።\nእንዲህ የሚያነፍረው፥ የማንንም ዕንባ፤\nየሰዎች ነገር ነው፥ ለልብ የማይሰባ።\nልቤን ሲያቃጥለው፥ አንጀቴ እያረረ፤\nሰውነቴ ጋመ፥ ሰንብቶ እያደረ።\nጥቃትም ቢበዛ፥ ሲጎላ ሲነግሥ፤\nበሰው ሰውነት ላይ፥ ይታያል ሲገሥ።\nሕሊናም ሲከፈል፥ እየሆነ መንታ፤\nአእምሮን አፍዝዞ፥ ያደርጋል አውታታ።\nይኸው አይደለም ወይ፥ የኃዘን ቆባው፤\nየሰውነት ዕንባ፥ ፍሬ የያዘው።\nይኸ ለጋው ቀንበጥ፥ ለምለም ሰውነት፤\nያማረው አበባ፥ አዳም ለጋ ፊት፤\nአመዳዩ ጥቃት፥ በጥኋት መትቶት፤\nአሳርሮት ቀረ፥ ከዚያው ካለበት።\n\nአሽን ነው አንዳች ነው፥ የሰው ልጅ ክፋት፤\nዘወትር ይፈላል፥ እንበለ መስፈርት።\nኮበሽ ደረመን ነው፥ ደግሞም አንከሊስ፤\nበያዘ ጊዜና፥ ፈጥኖ የሚብስ።\nሰው ሁሉ እንደዚህ ነው፥ በኔ በዘመኔ፤\nአስመርሮ ሚገል፥ የሚሰድ ምናኔ።\nመጠኑ አልመጥኖኝም፥ ለኔ ለመጠኔ፤\nትክ ብዬ ባየው፥ አተኩሬ ባይኔ፤\nእረ ይኸ መሬት፥ ይኸ ዓለምና እኔ።\nየጥኋት ጤዛ ነኝ፥ የሌት አመዳይ፤\nተንኜ የምጠፋ፥ ስትወጣ ጸሐይ፤\nየሕፃን ሕልም ነኝ፥ የቅጀት ጎዳና፤\nፈጥኜ ምጠፋ፥ ያለብኝ ሙስና።\nየበጋ ጥላ ነኝ፥ የምታይ በይፋ፤\nበጸሐይ የምነግሥ፥ መስዬ ማልጠፋ።\nበጸሐይዋ ጥልቀት፥ የኔ የሰው ጥላ፤\nጠፍቶ ይቀራል እንጂ፥ እንዳልኖረ ሁላ።\nነገ እንደ ዛሬ አይሆን፥ ዛሬም እንደ ነገ፤\nቅጠል ሰውነቴ፥ ፈጥኖ ጠወለገ።\nዛሬ እንደ ነገ አይሆን፥ ነገም እንደ ዛሬ፤\nፈጥኖ ይመጣል ባካላቴ፥ ሕንፃ የሞት ምዝባሬ።\nደስታ ሲመጣ፥ ኃዘን ሲከተል፤\n\nሞት እየነደፈ፥ መቃብር ሲፈትል፤\nየተሠራውን ልብስ፥ አድርጎ በውል፤\nእያስተካከለ፥ ፍጡር ይለብሳል።\nተቻቻይ ነው ሁሉም፥ እየሆነ ጥንድ፤\nዓላማው ከንቱነት፥ ፈጥኖ የሚነጉድ።\nመዓልትና ሕይወት፥ ሞትና ጨለማ፤\nአንደኛው ያለማል፥ አንዱ ሲያደለማ፤\nእየቅል እንጂ ነው፥ የሁለቱ ዓላማ።\nአለላ አይደለም ወይ፥ እንዳለሉት ኑሮ፤\nቀለም አይደለም ወይ፥ እንዳየሩት ኑሮ፤\nሲያቀሉት ሚቀላ፥ ሲያጠቁሩትም ጠቁሮ።\nእንደዚህ ከሆነ፥ ኑሮ ምትሉኝ፤\nዳናዬም አይሰማ፥ ዲካዬም አይገኝ፤\nእኔ ካሁን በስቲያ፥ የልም ሩጫ ነኝ።\nእንደ ዘላን ሁሉ፥ መላ ዘመኔን፤\nቢያዞረኝ ዕድሌ፥ ቢያስወጣኝ ከቤቴ፤\nአልመረረውም፥ እስከለተ ሞቴ።\nተጠሟሮ መኖር፥ እስኪረግፍ አጥንቴ፤\nሳይለምደው አይቀርም፥ ቀንበጥ ሰውነቴ።\nበዱር በበረሀው፥ በሜዳ ገደሉ፤\nደንጊያውና ዐፈሩ፥ ሣርና ቅጠሉ፤\nአዕዋፍና እንስሳት፥ ፍጥረትም በሙሉ፤\n\nሰማዩ ባጥ ሁኖኝ፥ መሬትም ወለል፤\nስሄድ እኖራለሁ፥ እያልሁ ሊል ዘሊል፡፡\nሰው ከሚሉት አውሬ፥\nእሩጬ ካመለጥሁ፥ ጠፍቼ በርሬ።\nመከራም የለብኝ፥ የመከራም ጓዝ፤\nከሰው አውሬ አልፌ፥ ከቶ ብቃብዝ።\nከዚህ አውሬ በቀር፥ ክፋት ከሠራው፤\nሌላው ወዳጄ ነው፥ አይጎዳኝ ሳምነው።\nረቂቅ ግዙፉ፥ ሁሎችም በተርታ፤\nየሐሤት ነጋሪት፥ የይባቤ እንቢልታ።\nአየሩ ነፋሱ፥ ድደንና ብርዱ፤\nናቸው ወዳጆቼ፥ የማይላገዱ።\nየክረምት ወጨፎ፥ የክረምቱ ጭፍና፤\nመርተው ይወስዱኛል፥ በሕይወት ጎዳና።\nከቆረጠ ልቤ፥ መሄድ አይገደው፤\nከዚህ ከሰው አውሬ፥ ከበሸቀጠው።\nመመለሱን ጠሉ፥ እንቢ ኣሉኝ አብረው፤\nልቤም የተከዘው፥ እግሬም የወጣው።\nልቤ ከጨከነ፥ አንዴ እግሬ ከወጣ፤\nይታዘብ ሕሊና፥ አቅንቼ ብመጣ።\nየማይጎድል ውኃ፥ ኃዘኔ ሙላት፤\nከሰው ዓለም ሰማይ፥ በክፋት ክረምት፤\n\nይዞ ወረድ አለ፥ የመከራ ዝናም የኔን ሰውነት።\nእንግዲህስ ወዲያ፥ እረ ሰው ለምኔ፤\nየሕፃን ሕልም ነው፥ አይረባኝም ለኔ፡፡\nከኮሶ መረረ፥ የሰው ልጅ ክፋት፤\nየሕይወት ዳፋ ነው፥ የኑሮ ዳፍንት፡፡\nተእንግዲህስ በስቲያ፥ ዘመድ ምን አለኝ፤\nበመከራ ሽጦ፥ እያንጫረረኝ።\nአየ ጉድ አየ ጉድ፥ አየ ድጉ ማለት፤\nለተቆረጠ ግንድ፥ ለደረቀ እንጨት፡፡\nእንደ ገደል ውኃ፥ እንባዬ ቢፈስ፤\nመጠንም ሳይኖረው፥ መሬትን ቢያለብስ፤\nእንሶስላ መስሎ፥ ፊቴ የቀላው፤\nየኃዘን የትካዝ፥ ትእምርቱ ነው፡፡\nእንኳን ለኔ፥ ሰዉ ለተወለድሁት፤\nከላይ መጣሁ ላለው፥ እሆናለሁ ብሎ ለሰው አብነት፤\nአምላኩን ሰቀለው፥ ሰው የሚባል ኣውሬ፤\nየተንኮል ሾተል ነው፥ የጽነትም ጨሬ።\nእኔ እንኳን በድሜዬ፥ ስንቱን አየሁት፤\nሕፃን ሽማግሌ፥ ጉብልም ባልቴት፤\nእንስሳትም የቤት፥ የዱር አራዊት፤\nየሰማይ ወፍ ሆነ፥ የባሕር አሞራ፤\nፍጡር እያንዳንዱ፥ ሁሉም በየተራ፤\n\nትምህርት ቤት ናቸው፥ ለተመለከተ፤\nበዓለም ውስጥ ካለ፥ ሥጋው እስከሞተ።\nሰው ይለኛል ነፃ፥ ሰው ይለኛል ጌታ፤\nባለም ወህኒ ቤት፥ እየሆንሁ አውታታ፡፡\nደግሞ ከዚህ ሌላ፥ ባካሌ ቢያጠላ ሰው የሚባል ጥላ፤\nነፍሴ ተጨነቀች፥ አጣችለት መላ፡፡\nእስኪ ተመልከቱት፥ ቆባው ሲፈነዳ፤\nእስኪ ተመልከቱት፥ ሰው ሰውን ሲከዳ፤\nቆባውስ ፈንድቶ፥ ይሆናል አበባ ያውም መልካም ሽታ፤\nሰውስ ሰውን ከድቶ፧\nሰው፤ ሰው፤ ሰው፤\nምንድን ምን ነገር ነው፧\nቢጥዱት አይበስል፥ ቢፈጩት አይፈካ፤\nቢያምሱት አይታመስ፥ ቢያቦኩት ኣይቦካ፤\nሽክሽክ ኣይወድለት፥ ወይንም ፍትግ፤\nአይነቀት እንቀት፥ ወይንም አይላግ፤\nምን መላ ይምጣለት፥ መላ ታጣለት፤\nለዚህ ለሰው ጥሬ፥ የሚሆንለት፡፡\nሲፈልጡት ኣይፈለጥ፥ ሲልጡት አይላጥ፤\nሲማግዱት አይነድ፥ ሲቆርጡት አይቆረጥ፤\nሲጠርቡት አይጠረብ፥ ተልጎ ኣይለዝብ፤\nለማገዶ ማይሆን፥ ለሌላም ጥበብ፤\n\nእረ እንዴት ይሆናል፥ ለምን ይውላል፧\nይኸ የሰው እንጨት፥ ጠፍቶ ያጠፋል።\nቢንጡት አይናጥ፥ እርጎ አይሆን ወይ ቅቤ፤\nእንደ ውኃ አይጠጣ፥ አይገባ ከልቤ፤\nቢያረጉት አይረጋ፥ ቢያፈሉት አይፈላ፤\nወገሚት አሬራ፥ እንገር ወይም አጓት አይሆን እንደሌላ፤\nይጠቁራል ይነጣል፥ እንዴት ይሆናል፧\nይኸ የሰው ወተት፥ ሰው ያስጨንቃል።\nቢጠጡት አያርስ፥ አይቀልጥ ቢያቀልጡት፤\nቢበሉት አይጠቅም፥ አልባ ጠመቀት፤\nቢነጠር አይጠራ፥ እሳት አይገባው፤\nለሞት ለፈውስ አይሆን፥ መዋያ የለው፤\nለጠጅ ለብርዝ አይሆን፥ ሲቀመጥ ቢኖር፤\nእረ ምን ሠራልኝ፥ ይኸ የሰው ማር።\nቢዘሩት አይበቅል፥ ቢያቀኑት አይቀና፤\nቢሸጡት አያተርፍ፥ ቢያኖሩት ቀጠና፤\nባዝመራውም ወራት፥ አይውልም ላዝመራ፤\nበሬ እያደከመ፥ ገበሬ አያኮራ፤\nምርቅ ነው ክርዳድ ነው፥ ይቀራል ባበባ፤\nይኸ የሰው ፍሬ፥ ቀረ በገለባ፡፡\nተፍንዱም ኣለቀም፥ አይሆን ለबुጭቅ፤\nከቶ ለማባዘት፥ ወይ ለመፈልቀቅ፤\n\nቢነድፉት አይነደፍ፥ አይሆን ለፈትል፤\nቢያኖሩት ጠቆረ፥ ሁኖ ባገልግል፤\nለማግ ለድር አይሆን፥ ለማላበስ ሸማ፤\nየሰው ጥጥ ቅጥ አጣ፥ ሄደ እየደለማ።\nብርንዶና ጮማ፥ እየተቆረጠ፤\nቢጠብሱት ኣይጠበስ፥ እየቀላለጠ፤\nቢቀቀል አይበስል፥ ለዝልቦም አይሆን፤\nአውሬ እንኳ እንዳይበላው፥ ሆነ ምናምን፤\nቢቆርጡት ደም የለው፥ እንግዲህ ገለማ፤\nይኸ የሰው ሥጋ፥ ሄደ እየደለማ።\nሲቀርቡት የራቀ፥ ሲርቁት ቀረበ፤\nሲመቱት ዝም ያለ፥ ሲተው ደበደበ፤\nሲያበሉት የሸሽ፥ ሲነሡት ነጠቀ፤\nሲችሉት ያልቻለ፥ እየነቀነቀ፤\nሲጠሉት ይወዳል፥ ሲወዱት ሚጠላ፤\nሳይጥዱት በሰለ፥ ሲጥዱት ማይፈላ።\nቢቀልቡት ከሳ፥ ቢራብ ደነደነ፤\nበዘር ላይ ወፍሮ፥ በመኸር ቀጠነ።\nቢያጠጡት ተጠማ፥ ሳይጠጣም ረካ፤\nእስኪ ይኸ ሁሉ፥ እንደምን ይለካ፧\nሲያነዱት ሚጠፋ፥ ፍሕሙ ተንደርክኮ፤\nሲተዉት ይነዳል፥ እንደ ፍግ ታምኮ፡፡\n\nቢሞሉት ጎደለ፥ ቢተዉት የሞላ፤\nቢያስሩት የሚፈታ፥ ቢያጥብቁት የላላ፤\nሲቀነበብ ወጣ፥ ሲፈታ ታሠረ፤\nአረቂ እየጠጣ፥ በውኃ የሰከረ፤\nበጭለማ ሚሄድ፥ በብርሃን ታውሮ፤\nከገደል የሚዘል፥ ከሜዳ ተሰብሮ።\nሳይታጠብ የነጻ፥ ቢያጥቡት የሚሸት፤\nመታጀሉ ንጣት፥ መንጻቱ ግማት፤\nእንዲህ አይደለም ወይ፥ የሰው ሁል ፈሊጥ፤\nሥራው የውኃ ሽታ፥ ኑሮው ግርምቢጥ።\nአየሁት ለየሁት፥ ፈጽሜ ጨርሼ፤\nዕንባዬን ጠርጌ፥ ፊቴንም አብሼ፤\nተለይቼ ልሂድ፥ በምግላል ነግሼ።\nቅስሜም ተሰበረ፥ ኣእምሮዬም ጠፋ፤\nቀልቤም ቀልብ አልሆነ፥ ሰውነቴም ለፋ፤\nምን እሆናለሁኝ፥ ብቻዬን ብኖር፤\nከሰው ተለይቼ፥ በጸጥታ አገር፡፡\nእስኪ ተመልከቱት፥ የዱሩን ዝሆን፤\nእንዲሁም ጉሬዛን፥ ደግሞም ሽኮኮን፤\nሽግርም በቅጠል ላይ፥ ዋዥንትም ስትዘል፤\nሁሉም በየሙኑ፥ ሁሉም በየትልሙ፤\nአያና ያማረ፥ ንሥሩ በሰማይ ላይ አንጃቦ ሲውል፤\n\nሲቀመጥ በሕይወት፥ ለብቻው ባለሙ፤\nዘመኑ እስኪፈጸም፥ እስኪረጋ ደሙ፡፡\nምቀኝነት ጥመት፥ በእንስሳት ዘንድ የለ፤\nሕይወታቸው ፍሬ፥ እጅግ የበሰለ፤\nጥቃት መገፋትም፥ ጭራሽ የለ ከቶ፤\nከንስሳት ዓለም ውስጥ፥ ወድሟለ ነኳኩቶ።\nከሰው በመኖሬ፥ ተንኮልን አወቅሁ፤\nክፋትን ጸንሼ፥ ተንኮልን ወለድሁ፡፡\nለዚሁ ከሆነ፥ የኔ መፈጠሬ፤\nአስተዳድሮ መኖር፥ ሕይወቴን ላዳሬ፤\nጥንቱን ባልተፈጠርሁ፥ በሰው ማኅጸን፤\nይሻለኝ ነበረ፥ እንዲህ ከመሆን።\nሰው በሰው ሲነሣ፥ ባለም ዲብ ሲኖር፤\nዘገሩ ነገር ነው፥ ኑሮውም የጦር።\nሲዋጋ ይኖራል፥ እስከ ዕለተ ሞቱ፤\nድላሉም ሞቱ ነው፥ ሀብቱ ለሕይወቱ።\nየበሸቀጠ ነው፥ እንዲህ ያለ ኑሮ፤\nየአእምሮ መሸርሞጥ፥ የሕሊና እሮሮ።\nመኖር ከዚህ ሥፍራ፥ ከእንዲህ ዓይነት ቦታ፤\nልቡናን በመንሣት፥ ያደርጋል አውታታ፡፡\nይሻለኛል እኔ፥ ከዚህስ መራቅ፤\nከሰው ተለይቼ፥ ቢቀርልኝ ጠንቅ፤\n\nሕሊናዬ ነፃ፥ ኣእምሮዬ ንቁ፥ ስሜቴ ምጡቅ።\nጥበብን ቀለቤ፥ ዕውቀትንም ስንቄ፤\nበማስተዋል በውነት፥ እኒህን ጠብቄ፤\nመኖር አይሻልም ወይ፥ በተፈጥሮ ቤት፤\nእጅ እጅ ካለው ገምቶ፥ ከሰዎች ሥራት፤\nባህል ልማድ እድር፥ የግም መሸፈኛ፤\nሰዎች የፈጠሩት፥ ለእውነት ለሠናይት ለውበት መጋኛ።\nመረረኝ ጎሽብኝ፥ ከሰው ጋር መኖሩ፤\nእንደ እሾህ ቢወጋኝ፥ ሁሉም በነገሩ።\nልቤን ደም አስርቦት፥ እጅግ ደም ጎረሰ፤\nሕንፃ ሕሊናዬም፥ ሄደ እየፈረሰ፡፡\nቢታይ ቢመረመር፥ ቢታሰብ ቢወሳ፤\nሰው ያካበተልኝ፥ ብሶትና አበሳ፤\nምንም አይወስነው፥ ጥልቀት ወይ ምጥቀት፤\nእስከ ዓለም ዳርቻ፥ እስከ ሰማያት፡፡\nእንግዲያማ ለዚህ፥ ሰው ላሉት ነገር፤\nእቡሰ ልብ ሁኖ፥ ባለም ውስጥ ሲኖር፤\nቁናውን በቁና፥ አክርማውን ቀጭቶ፤\nማሰፈር ነበረ፥ ሁሉን አስለክቶ።\nየሟለጠ ነገር፥ ሞረድ አይገታው፤\nይኸ የሰው ብረት፥ ከቶ ማይተባው፤\nከቶውን ሳይተባ፥ ስለት ሳይወጣው፤\n\nዐፈር ፈጅ ሆነ፥ መሬቱ በላው።\nመንከራተት መዞር፥ አይሰለቸኝ ከቶ፤\nአካሌ ለምዶታል፥ ሁሉንም አካቶ።\nግራ ቀኙን ብዬ፥ በሕይወት ጎዳና፤\nእዘልቀው የለም ወይ፥ ይኸን ያለም ጭፍና።\nመዓልቱ ሲጠፋ፥ ሌቱ ተተክቶ፤\nይለወጥ ይሆን ወይ፥ ሰው ሁሉ ሰንብቶ፧\nነፋሱ ሲነፍስ፥ ደመናው ሲጓዝ፤\nየጎተራው እህል፥ ሲበላው ነቀዝ፤\nየሰው ልብስ ቢሆን፥ ከጥንት እስከዛሬ፤\nይኸው እዚህ ደርሷል፥ ይዞት ምዝባሬ።\nለምለም ሰው ጠውልጎ፥ እየከሸለለ፤\nቆባው ባዶ ሁኖ፥ እየጠነዘለ፤\nየፍሬው ጎተራ፥ ፈርሶ ሲደረባ፤\nከንቱ ሁኖ ቀረ፥ ያለም ሰው ባበባ።\nየታመመው ሲድን፥ ጤነኛውም ሙቶ፤\nያልዘሩት ሲበቅል፥ የዘሩትም ጠፍቶ፤\nየዚህ ዓለም ኑሮ፥ ኑሮው ታላቅ መርዶ፤\nይካበታል ፈጥኖ፥ እንዲህ ወርዶ ወርዶ።\nኑሮዬ ኑሮአችሁ፥ መዝገበ ቃላት፤\nመደምደሚያው ቃሉ፥ ሁለት ቀለም ሞት።\nያልታሰበው ሲሆን፥ ያልተተለመው፤\n\nየታሰበው ቀርቶ፥ የተወጠነው፤\nይሆናል አይሆንም፥ ሲያዩት ይኸን ሁል፤\nውል የሌለው ነገር፥ ያወላውላል።\nሕይወት የቃል ጉዳይ፥ በጽሑፍ ያልሰፈረ፤\nይረሳ የለም ወይ፥ እያጠራጠረ።\nመሞት ጥብቅ ውለታ፥ የማይዛነፍ፤\nተጥፎ የመጣ፥ ከጥንቱ በረድፍ።\nይኸ መሆኑን ሳውቅ፥ ልቤ ሲረዳው፤\nከሰው ጋር መኖሩን፥ በምን ልመኘው።\nከሰው ጋራ ብኖር፥ ሞት አይቀርልኝ፤\nብቻዬንም ብኖር፥ ሞት አይቀርልኝ፤\nኋለኛው ይሻላል፥ ለኔም ተሰባኝ።\nንጽሕን ለመጠበቅ፥ ሳይተዳደፉ፤\nብቻን መኖር ወሰው፥ በሰው ሰው ሳይጠፉ።\nአለላ አይደለም ወይ፥ እንዳለሉት ኑሮ፤\nሲያቀሉት ሚቀላ፥ (ወይም ሌላ ቀለም) ሲያጠቁሩትም ጠቁሮ።\nዓላማውን አያውቅ፥ ሕይወት የሚጠፋ፤\nየእሽኮኮ ጸሎት ነው፥ ሲሰሙት በይፋ።\nሕሊና ሲሰለጭ፥ ሲታክት አእምሮ፤\nየሕይወት መቃኛው፥ ይሆናል እሮሮ።\nእሽከለኬንታችን፥ ወይ የዕንባ ሸለቆ፤\nየሰው ልጅ ሕይወቱ፥ እውነት ሠናይትን ውበትን ደብቆ።\n\nእኒህ ተመልሰው፥ ምድረ ርስት ሲገቡ፤\nእመለሳለሁኝ ያኔ ነው፥ ዕውቀቱ የሰው ልጅ ጥበቡ።\n1952 ዓ. ም.",
