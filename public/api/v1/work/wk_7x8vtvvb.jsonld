 "@type": "Book",
 "alternateName": [
  "Birch'qu Timehallel!",
  "You Swear by Glass!"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_w3mte77q",
   "@type": "Person",
   "name": "ዓለም ፀሐይ ወዳጆ"
  }
 ],
 "description": "ብርጭቆ ትመሃለህ!\n\nአስናትህ ማሀህን በምጓቃት ስትወጣ\nአስታውቆህ ዓለም ውስጥ ስትፈላለግ ስትመጣ\nእንደ መុህኑ ጨንት፡ የነ ስትወለድ\nደግሞ ታልቅሳለህ ከሀገር ስትሰደድ\nእንኳን የማያውቁህ የሚወቁህ ይረሳሃል\nለሰባቱ ይበርደዋል ጠበህ እርስብሃል\nብትችሉት ማርክ እና ያደርግሃል\nአይከብድ . . . አይንህህ\nአይሰሙ . . . እያነካህህ\nአይረፉ . . . እየውቁህህ\nልቦች ሁሉ ድድን ዓይነቶች ሁሉ በዳ\nሁሉም ጐደሎ ነህ ሁለግዜም አንጓዳ\nብትወድቅ ስትሃይ ቢሞት እትሻገር\nበቃልምዕራብ ጠሪ ሰው የለም ሰው ሀገር\nመርምህ ተወራለሁ ተጠንቀቅህ ረግሙህ\nፍርሃት ይወርደሃል በሚያስኝህ ተበአሙ\nጨንህ ታለቅሳለህ እንደ አራስትህ\nስትሄድ ስትሰደድ ከሀገርህ ከሕንቱ\nየሰዎች ክብርህ ከታለሁ ጋር ወደቅ\nሰደት አሰደደት ከእንትነትህ ርቀ\nፈቅደህ ስትጐዳ ውደቀት ሲያመቀህ\nትዕግስት ሁ . . . ሁ . . . ብለህ ለ «ይሁን» ሲያበቀህ\nእንደ አላስትህ እንደቀዳሞው ቀን\nብርጭቆ ትመሃለህ! . . . ቀን ሲጠራህ በቀን!",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ብርጭቆ ትመሃለህ!",
 "partOf": [
