 ],
 "description": "የዋየውን መንገረ እንሤጥሽ ስታር\nሳትማሙ ፤ ስትማሞ በአብቢር ሳትያር\nተሰለ ጫፍ ሁኝኝ ተሰለ ፊትበ\nእ-ማን ሳይወህንች የትም- የት- ስተ-ሄደ I\nእቲ ምን ምን አሰልሽ?\nወደአሳ ሼች ሸ?\nመስኝት ከማሌቱ ያስቃቀልሽ?\nወልቱ በሌላት ምን ይሆን ሐሰል\nእዛት መስአለችኝ ጕጅሽ ስተባብ",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ወልቱ",
