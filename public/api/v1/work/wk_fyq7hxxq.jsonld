   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "በሰሙ ሠየማት\n\nመቀጠባትን ቆረደል የትግል አዘጋጅ\nደሙ ፡ እጅረአ. ለአበይት ሠለአኝ\nባባይ ዓመታት ለረዥም ዘመንት\nውሉ እንደ ርብ አንስት ተቀምጠው እንደ እሳት\nእንደ ሠው ለርን ነገይንስ ልማት ።\nመቀጠባትን ቆረደል ፡ . . .\nችል ብለት አያውቅም\nየህይወትን ፊደል አርና ዱር ቆ\nቃል ከደን ነበሮ በሰሩ ጐሎ ተፈቀም\nየሰለ ሲለደርጫት መድፍና ተምም\nቃልኪዳኑ ነበረሩ ፡\nየህይወትን ዕደል ቁጥጥሩና ፲፻ኝ\nእጅግ ላምም ሿሿ\nወይ ዕውቀት ፍሬዎችን ፡\nለመንበር ጣንች ስቅና አፍና\nየየዛትትን ጐልሙን ተንእ ትዳትትን\nካለይዎ አራፄ አኑፍ አትፍ\nበወሂ - ለይፋት\nበአምሳለ ሲቀዕጋት አንዳፈራት መቅፍ ፡\nአንዳፈራት ጤና ሰላም ብለጸግና\nም.ይተአመ ናዝሬት እኮሮያ እሮማ\nየምነት ዕውብ ፋና ።\n\nእነሆ አደፈረ ፡\nቃል ኪዳን ቃል ሁና እየላው ስላማ\nከመልዳ ልጆች ከምስማማን ትሎች ብርሃንን ስቀጥ\nለታግሡም መስከረር ልደስ ለቅኝ\nበየት የህይወት ፈደል\nበካት የደረሰ ዚክ\nለፍቶ የደው ዕደል\nለፍቶ የደረሰ ዚር",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "በሰሙ ሠየማት",
