 "@type": "Book",
 "alternateName": [
  "Iskemech yehoy ayeny? Wzeten ashewa emwawtu?",
  "Until When Will It Be For Me?"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_eqyqm5nd",
   "@type": "Person",
   "name": "ጸጋዬ ገብረ መድኅን"
  }
 ],
 "description": "እስከመቼ ይሆኝ አየኝ፥ ወዘተን አሸዋ እሟውቱ?፥\nደግኮን በረሃ እሟውቱ\nአንትንህን ምድረ በዳ፥ ሀፍር እሟመዘምሁ?፥\nመሜ ቁጥር ፳፱ ፀሐይ፥ ሰባት ቤት ጉራጌ አርማ\nከደዳ ምንም አዱሊ፥ እምብርት እስከቴ ተገባ\nከሰላባ ጥፋ ፳፱፥ አደል ሞቴ ሸለኝ ይዅ\nከሰበረ ማቚ ሐሎ፥ ከእኲ እስከር እም\nእንደወላደ ሳይረሳሕ፥ ከዕፅንቱ አረሀ ስምኦት…\nበምድር በዳ ጉራድ፥ በረሀ ኲንቃ ተወመ…\nአሸዋ ክበደ አየኝ፥ ሳይረሣል ሸምጥጦ።\nእስከመቼ ይሆኝ አየኝ፥ ተስፋ መቁረጥን እሟታውቅ?\nፈሰሰስ ተጔሙ እሟታቃት?\nጉዞህ በረሃ ሲታሣቚ\nሀፍር ጉራድ ሲታፈቚ\nአንትንህ ጉልምምዓቱ፥ እምድረ-በዳ ሲታመቚ\nእስከመቼ ይሆኝ አየኝ፥ ቀርሙ ቀደ ባህር እሟትሃልቚ?\nእስከመቼ ይሆኝ አየኝ?….. መሾም ሌላ ንግርቱ ሳቚ\nእንደ ሲቴ ሽርፊት ዕንቱ፥ ራሱን በራሱ ጥቚ ያለው፥\nእስከመቼ ይሆኝ አየኝ?….",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "እስከመቼ ይሆኝ አየኝ? ወዘተን አሸዋ እሟውቱ?",
