   "name": "በዕውቁቱ ስዩም"
  }
 ],
 "description": "...  የው እንደገና ሳህ ቀድሮ፥ ታሪክ ሆነ የቤት ጣሙ\nአለሎ እንደሚጋሩ ጉራንጉ፥ ሲግዝ ነው ዓላሙ\nየማለዳ ስማይ ሲምር፥ ቢማርክም በቀላሙ\nሲያዩት ደብን ሲመስል፥ የቅንብር ስሀል ነው ኸሙ፡፡",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የማለዳ ድባብ",
