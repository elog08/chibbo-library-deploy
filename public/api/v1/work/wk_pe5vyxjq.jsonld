 ],
 "description": "ይነዳል\n\nጥቁር ሻማ የለበሰ\nለእልልም ምድር ተዘርግቷል፥\nምድር ውስጡ\nህዝብ አጠቃሏል፥\nህዝብ ውስጥ\nታሪክ ተኛቷል፥\nታሪክ ውስጥ\nእውነት አዛምቷል፥\nእውነት ውስጥ\nአርነት አለ...\nይነዳል እንዲህ እያለ !!",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ይነዳል",
