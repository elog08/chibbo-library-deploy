 "author": [
  {
   "@id": "https://chibbo.app/person/pe_xgde6t8m",
   "@type": "Person",
   "name": "መክብብ ደስታ"
  }
 ],
 "description": "አልነሣኝም፡ እንባ፡ ከዓይኔ፡ ሳይጠፋ፡\nጠራሁት፡ ዐውደ፡ ምሕረት፡ ቆሜ፡ ተስፋ፡\nእንደ፡ ምን፡ ልርሳው፡ ቃልኪዳኑን፡\nእግዚአብሔር፡ ሰጠኝ፡ ጸጋውን፡\nየእግዚአብሔር፡ ቃል፡ እውነት፡ ነው፡ ዛሬም።\nአልሠረዝኩም፡ ቃሉን፡ ከልቤ፡ አላወጣም፡\nበእግዚአብሔር፡ ፊት፡ ቆሜ፡ አላፍርም፡\nእግዚአብሔር፡ ሐኪሜ፡ ነው፡ መድኃኒቴ፡\nየሚጠብቀኝ፡ ነው፡ በእውነት፡ ቤቴ።\nየእግዚአብሔር፡ ቃል፡ ሐሰተኛ፡ አይደለም፡\nእርሱ፡ ይጠብቀኛል፡ አያሳፍረኝም።\nእግዚአብሔር፡ ንጉሡ፡ ነው፡ የዓለም፡ ሁሉ፡\nእርሱ፡ ይረዳኛል፡ ይጠብቀኛል፡ አባቱ።\nእግዚአብሔር፡ እውነት፡ ነው፡ ፍቅሩ፡ እውነተኛ፡\nእርሱ፡ ይጠብቀኛል፡ ከእንግዲህ፡ ወዲህ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የእንባዋ ቃልኪዳን",
 "partOf": [
