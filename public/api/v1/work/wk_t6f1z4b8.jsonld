   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "የ-፪ኛው ጕልበት\nየየሽካኝ ክፋይ ጐንደ አፍታ አኪንጐ ይወወቅ ትልቁ ።\nወይ እቀወግ ፡\nየወዛሊ ጎአረዎች በአለሬ ሳንዋህ በአርዕ ሳአማ\nበታልኝ ከ ኰቴ ሠወቲር ኲላላት ስአማ ርሰአ\nበላላ በሰሮ ሠንቀትን ሳአቀቀ ፋላቅኀ ለከ\nበኪርቴ ጐብኝ አቅርቆ ቀላቅኝ ሕርኰ\nምን ትባይ ፀሐይ\nምን የሚላት ብርሃንን እንዲህ ዘማሪ ጨረ\nከፍዕቱ ጕጅ ከሰላ ቀሳ ግባት በወር ጭ ሐሬ ? !\n\n(በድርሰ-የወንድና የሴት ድምፅ)\n\nእንዳዚህ ከተዋተህ በአንተ ዜማ በአንትሮትር ቃና\nበደይንህ አያልፍ መፍ ሕይወት ቀደም ይህ ሁሉ መር ማና\nእንዳምንህ ነበረ ?\nአንዳር ስብርር ቅልህ አስረኝና የትኛ ደም የተሣረፈ\nተፋታኝ እንድንታህ ከበቶትን ያህል ፈላእ ኛኝ የሰመረ ?",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የ-፪ኛው ጕልበት",
 "partOf": [
