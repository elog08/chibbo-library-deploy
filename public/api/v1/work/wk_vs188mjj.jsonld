   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "አይ ጅኒ አይ ጅኒ\nየበየው ጭቍት ፡ የቤተክስፕ ሙሉ\nብኝ ትዝዝ በህደራ ፡ ፍዘ ደንጋይ ዓውድ\nሽር ብር በንግእት ፡ ሽው አካም በንደ\n ውትርት በሰለል ፡ ፍሽ እስከ በንደ\n ብቅ ትልቍ\nፓቅ - ቢቅ በጕም ጭቍ ግምት\n —አፍራን ስንጥቅ—\nአማራከን ለደረሰ አውሮኘ ልገባ\n(ከበክለ አፍር፻ ፤)\nበሐበሾች ምድር ዘመድ አረጎ ብሎ\n እዚህ ሙ-ት ሲገባ !\n አይ ጅኒ አይ ጅኒ\nሰው ሊምን ይሞቃል ?\nባህል አፈራስ ብሎ ይህን ጂኒ ጂኒ\nችማል በአፍ ማሟል\nዕዕ አሽሾ አሚደር አሰ እእሁ- መጥሰ\n አባ ሆደ ተብዬ\nልስር ሰላላ አልተመደደረች\n‘ሰምሳሌ ’ እያለ\nሞት ማታ በአሜደት ቅሰሙ አየደቀቀ\n ወግኝ እያለ ፥\n አይ ጅኒ አይ ጅኒ\nዕድሳችን ርቅ\nውም ወረዱን ንቅ ሲገባ ስሰባ\n ከብያ ጐባፄ\nይቀራል ዓለም\nየምሟ ሳላኝ የተዋቀወካ ከቻ\n ጉንፍ የተለየ\nከምድረችን ባህል ለምርጥ ገመች ፥\n ጀረሳ ፕማ ወረቀ ወዳልበት\n  ሰማያዊ ሰዎች ።\n\nክፍፍ አካል አሰነሪ ፤ ጥርሰ አካል ሆን፻ቸ\nተንደቀቀ አዕዋፍ ፡ በሥራ ፎርዎች\nቀንሣቸው ፕሻ ገበያ ፈር፻ች\nወደየፍቸው አሚጡ- እየበብ ኬርች\n ውለእ አሣማዎች ።\nይቀጥላል ዓለም ፤ . .\nከበክለ እሼክ የረማ ግል\nወቅር ማይኔትጥ ቀደሞ ሳይዘሬ\n ግንድ እሟ-ለ-በት\nአባብ ክርቲግ ማጨት ከሰለ\nኰ-ታ ክገ ሳባ አግባብ ከትሰና ፡\nሰላም አለ ብዙ እሚለእለ ስሰ\n አማያውሣው እሰ\nእንደ ባዴ አካል\nተንገጥገጠ ሲሔድ ራሱ ከለብ\n እጆ፻ እሰማ ፤\nአቅቀቶች ሰትግር መሳበል መሳብ\n አየደር ሐ.ደ\nየግሣ አፍንጫው ጀአለ ከድሮግሁ !\nወንዘትን ቍምጥ ኖሮ ግን\nደማቅ መሃል ይሣ፲ር ሠርች ፤\nእሠተወሙ\nደማዎ አያግዘ መንጃው የደረከ\n ይበሃል ትራሪክ\nየመኪና መንገደ የፈማል ከሰካፋቴ ፡\nጀሮ- አየለ ይማውፓ ጕላት\nየሰነት ሲሰ.ጥታ\nየማማት ከርፋቶ -\nበቃን! ወስት - ጃለ—\nየኛም የሰል ፋልሞፓ ተማይ ፤\nደግሞ- ሰሰጫ የች -\nየመላክስትና የሕንፃት ተሰበ አሻላል ሳለ",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "አይ ጅኒ አይ ጅኒ",
