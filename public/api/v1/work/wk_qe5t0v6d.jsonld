   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ሥራህ ይተዘነሃል መሆንህን የጻድቅ\nየመመንኰስ ኟፍ ማዕቀት\nየገዛበነት መስታወት\nየደመቀንት መጽሐፍ ።\n\nእለ ካንተ ወደብ ማን ሊመጣ\nአባቱን መስሎ የወጣ\nአንዲትም ያንቱ ልጅ የል\nጥበብን አፍሮ የጸለ\nአወፍሮ ያሰለና\nአንድም አንትን መሰሎ—አባቱን መሰሎ የሚለ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የሳቱ ልጅ (መጨረሻ)",
 "partOf": [
