   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "የገደል ሣማፍ ትንቚ ፤ ከእንቅልፍ ትረዳ ትንኲል\nከዘይን ሕልም ትሬጌል ።\nእንደበታችንን ዝህል አማምሮ ፤ አዕምሯችንን በበለ\nቃል አሰጥቶ ሐሳቢ ገደል ።\nያይንን እውነት በእርግብም አሰሰሰኮ\nየዌርን ታሪክ በምምታ አብለወልቶ\nእንደበታችንን ዝህል አማምሮ ፤ አእምሯችንን በበለ ።\nየወርጭ ድምፆችን ፤ እንደ አምኃ ዛሬ ይደርሰኝ\nየዘመናት ቀላችን ፤ ወጥ ፊትሽ ይቀበለኝ ።\nየፍሬዎች የምሥራቅ ከፍ ምን ም መሆን እንኲማሽ ።\nከኝ ልማዳት አትጠብቄ\nከኝ ሐሊት አትጠበቄ ።\nእንኲም ለኛ ፤ ተናካ ፤ አበክሽ ሰለ አንችን አንቺ ማቂ\nአንቺ ፤ ሰለ መሸንዮች አንዴ ረፈቀ\nአንቺ ፤ ሰለ ጭንቅ ድምፆችን በርቀ ።\nአለሞሣቚ ይቻላል ፤ አለማቀቅን ነው ጭንቅ\nየመንፈስን እንግርርጥር ፤ በመንፈስ ዓማቅ ማወቅ\nውስጥ ወስሙን እየሰመ፡ ፤ በዋቤ -ተነስተ መደፍቀ\nለተሰለመመልኝ እውነት ፤ የደም ደንደሉ ማርቀቀ\nበቅልጀት ስደድ እሳት ፤ አቀሳትን መልፍለቅ ።\nአለሞሣቚ ይቻላል ፤ አለማቀቅን ነው ጭንቅ ።\nአና ፤ እስት ፄላን\nፄላን እንዲህ\nፄላን እንዲህ ሣቂ ፤\nእስት ፄላን\nፄላን እንዲህ\nፄላን እንዲህ ፍፃሜሽን አትደበቅ ፤\nአትደበቅ—ለማማጀትሽ አትከርቴ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ዘርዕ እብርት ማሞች",
