   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ጾም ገርት. . .ጾም ጥቅል. . .ጾም ገልገል።\n(ቢ-ቢ, ትቀልድ ይመስላል)\nልጅቱ—የዘመኖችዋ\n  ጥርሣው—ብሎ ጥቅልል\n  ወደ ቁርሲ መለሰ ስትል\n  አማዋዎ ንድድ ቄጥ\n  ትንሽ እህቷን ጥርች\n  በብር-ም ገጥቅ !\n\"ገና ሁኑ እወጣብሽ\nለምንው ቤት መኃኝትሽ?\"\n  ደሞ ማላት።\nአባባዎንም እንኀ ቄይት\nአርፍታቸውን ኸንገት\n\"ወይ ጉድ መበለሽ\"\nአርዘመው እያዩ ማላት።\nልጅቱ-የዘመኖችዋ\n  ገቢብ ገቢብ እያለች\n  አማዋዎን እማዋለች\n  አባባህን እያረመመውች\n  ብርሃንን እንደ በለች\n  ሳለቲካ ብነ ነገር እያላመጠች\n  እያንቋማልች\n  ርፍር ብለባት ትክለ ትክለ እያለች\n  አሕድሮ ሚዜ ነገር ገፍቃት ያላቸው\n  (አፍንጫ ሳትቅዬ—ወደያውኑ)\n  ሰት ሚቱን ምልክ ተላያለች።\nልጅቱ-የዘመኖችዋ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ልጅቱ — የዘመኖችዋ",
