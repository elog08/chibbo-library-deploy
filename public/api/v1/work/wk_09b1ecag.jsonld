 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "የን ዘመን ጉዟቸውን ።\nየጸለሰለ ኦይናቸውን ።\nያቀመሰ ድምጻቸውን ።\nአባካቸው 1 አለማርያም ፍርሃታቸውን ።\n\nየን ቀን አቅቡሰ ላይ\nስትማራቱ የሞተውን ላይ\nከእንቅልፋቸው እንደ ፕላስ ጨሐለ\nኰነበ ቊሥትከ ከቊዩ ተንጋ ።\nደማቅ ሰማያዊ በኒ ታቀፈህ\nሞት ሰላይ እጅ ጠበብ ለቀሀ\nከት ዛለቭ ዕድፍ ደርሰህ ፤\nበማዕ እጅህ ከዘርህን ።\nበቀሡ የልጃቸውን እናት ጨልመው ፤\nገባ ሰትል “ወንድሞቹ” የላለው ኦይዙን ሳለመው!\nከበደ ገጸ ገለመጠው ፤\nበመሽሽክታው አግለለቡ\nባንድ አደም አንትን ለፔዩ ፤\nአትወንዝ አትቀበዝ አለው!\nከአደ አንተ ጠፍሮ ፤ ረሰቲ ዕለቲ መቀ\nእማ ሳ በንታ ተርበሪሮ፣ ተሸሿሮ ።\nበሊሉን ሸሿና ለውሳ\nበላዬ ደቁ ነገር ፤ ጨለ አድሳ\nጸጉርን በብለ አርካ\nጩጮውን እንደ ጨለሙ፣ የት ተቀመጠ? የት ታፈራቱ?\nእንደ ባለቱ አርካሽ በቃው—እካኑ ነው አሚኖባች ።\nበልና ታሰፈርት ።\nወመልደ ተሰፈርት ።\nአስቴ በል ፤ የችኝ አሻ\nየሀገር አሻ፣ የት ታፈራቱ?",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የሤትማ ግርዋት",
