 "@id": "https://chibbo.app/work/wk_4nag2rzz",
 "@type": "Book",
 "alternateName": [
  "Sile Serf Adir",
  "About the Serf and Night"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "(በጠባብ - የሴትና የወንድ ድምፅ)\n\nስለ ሠርፍ አድር\nታሪኩ ነው ቅሬ ነው ታሪክ\nአለቃት የለለው መጠን ወይም ልክ ፤\nደም ሆኖ ተፈጨ\nበመስከረም ፀሐይ በለባት ብርሃት ዜና\nየምልም አጆች ታዩ ተገለጡ በዕርቃን ጐመና\nምጓት—ትጓኝካ\nቋም ቢያርላቸው በደሙ ሳይም ቢያውቅ\nከወገአበር ቀርበው ተፈጠሙ ጨሩ ።\n(በድምር—የወንድ-የሴት ድምፅ)\n\nበሰማያዊ መስከረም ሰማይ\nየአስጠኝኝ አባቶች ፀሐይ\nብራል—ዕነቃማሽ—ሲሳይ፡\nምን ያህል ዘመን ምዕት ዓመት\nምን ይላል ትግል ምን ጥረት ፤\nልወዲአ.ሂምን ያህል ጨለማ\nጨለማን ያህል ሰላት\nገረፈ ፡ በድል ለመምጣት ?\n\n(በጠባብ-የሴት ድምፅ)\n\nመስከረም\nየብዘ-ሃን ብርሃኑ ሰማይ\nማፍ ሩማቅ አደባባይ\nአባቶች ዕነቃማሽ-ሲሳይ\nአይምሩ አዕብቃት\nይጐማዝኑ ጯጊያችን\nከበ ግርአና ጸጋዎችሽ ፡\nድልላቸው ነውና ድልሽ ፡\nድልላቸው ነውና ድልአችሽ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ስለ ሠርፍ አድር",
 "partOf": [
  {
