   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "አቤ የኔ ዝምታ ጣምርታ\nአይወለድ ቃል—አንጓት ።\nበከተማው በገማ\nበአኛማው በሸላፊው በራፋ\nበየቀውሉ በየዕርፍ ።\nአኰ-ጀት ሲቀላት እረፍ—\nፍጥረት ሳንደርባት ሲሞታ ፤\nሆን ብሎ በሺር ላይ ተገኘ\nየልኑ ማይነት ቀጥፄ\nፍርሃትን—ክብር አደረግፄ ጣምራ\nአልው—የኔ ድምፅ ተወቀቄ\nአልው—የኔ ልማን አፍኟ ፤\nሲጐትላት ጽማ አርማ\nሲነካኳ ንኟ ሞምሞም ።\nአቤ የኔ ዝምታ ጣምርታ\nአይወለድ ቃል—አንጓት ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "አቤ የኔ ዝምታ ጣምርታ",
