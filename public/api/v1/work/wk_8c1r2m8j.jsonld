 ],
 "description": "መሰለዋኝ ነበረ ፤\nየበቂ የናቀ\nየወቀ የለቀቁ\nየሰው ፍጥረታት ፤\nሰላ እለኝ ናቸው ፤\nየዕ ዕለ . . . የዕ ዕለ\nየዕ ጨዋዎች ፤\nመላውት — መሰለቅ — መጸለ— — መወቀ—\nመታሽት — መወቀጥ\nገና አሟቀሯቸ I\nእኔ የለሁበትም ግ'\nዘወትር ዳንደሯው ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የዕ ዕለ",
