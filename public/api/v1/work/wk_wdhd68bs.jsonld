  }
 ],
 "description": "ራስህን አከሽኝ\nሲያችአለሰክሶው።\nማር-ወተት ሳያረም\nከንፈሩን ሲሰመወ፡\nእያስተማረኝ መዋት ፤\nብቸት አደረገኝ\nየተለይ ጃቢስ መሆኑ አቆቀኝ።\nሲጋ ጊኢዜ ላይ መሸአቱ ነደደኝ ።\nእንዳይሰማው ፈርቸ\nልብ እንትንፍሽኝ I\n“እስትንፍሰኝ ባል\nበት ነገር አለ!”",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ድንቄም መምህር",
