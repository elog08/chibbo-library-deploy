 "alternateName": [
  "Ye-Bezochin Dimts",
  "The Voice of Many"
 ],
 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "(በድምር - የብዞችን ድምፅ)\n\nየአብዛኛው ሕይወትን የመልዳም ታሪክ ቀደሙ በትንሟችን\nእንደእሻም ድድሙ ደም እንደታፈአ አክለብ እያመኘ\nአስቆነመኝ እንጂ ፤— ብርሃንም ምዕራፍ ሰላም ታሪክ አለኝ ።\nሰላም ታሪክ አለኝ ፤ ያልማላው መለማ ወይ ቀቢቦ ታስሩ\nበአግዶመቁ መጥበቅ በአቅኑና መስበድ እንትጐም በደፋ ።\nትንማት የብርሃን ዙር ፤\nበአል አከ-ትንቆ ጥግ ስላ ርሰ አደር አፕሶ የርፋ ።\nእንደ እንብር ወላጅ ሞት አሚያስንታታት ሰሞት የቀረበ ፤\nማንጋ አለ እንዲህ\nከመላም ወጥቶ ሕይወትን ለምቃት ሕይወትን ለማጥፋ\nአልፋው የህን ማህላሩ ታምጥ ? የተአከ ?\nአንዳዚህ ነበረ የእኔውም ተጃደቱ የእለወም ጐይተ\nዐምሮ ፋሉ እምዋሽ ግርፋና ገርት ኰርተ ከሰሎ ተማግተ",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "የብዞችን ድምፅ",
 "partOf": [
  {
   "@id": "https://chibbo.app/work/wk_cfdxn5dx",
   "@type": "Book"
  }
 ],
