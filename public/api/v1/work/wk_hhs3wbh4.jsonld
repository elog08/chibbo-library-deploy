   "name": "ዓለም ፀሐይ ወዳጆ"
  }
 ],
 "description": "ከፋ፥ ሰው፥ ከፋ፥ ነው፥ ከፍ፥ አይመስለም ከፋ፥\nጐደ-ንድ፥ እየማሳ ሰወ፥ ሲ.ይል ሰካ፥\nእንገተ-ን፥ ቃልሰ\nቃሉን፥ አሰሰሰሰ\nሲ.ግ-ዳ፥ ሸም-ቀ\nሲ.ያም፥ ተጠነ-ቅ-ቀ\nከፍ-ም፥ ከፋ፥ አይመስለም አሣች፥ እንጂ፥ ሰሰወ፥\nሸሽ-ግ፥ አደር-ገ-ግ፥ ነው፥ መር-ዘ-ይ-ን፥ የም.ያ.ሰወ፥\nከፋ!",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ከፋ አይመስለም ከፋ",
