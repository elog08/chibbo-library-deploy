   "@id": "https://chibbo.app/person/pe_xgde6t8m",
   "@type": "Person",
   "name": "መክብብ ደስታ"
  }
 ],
 "description": "የኢትዮጵያ፥ ንጉሥ፥ አባት፥ አንተ፥ አትፍራ፥ እግዚአብሔርም፥\nከእርስዎ፥ ጋር፥ ነው፥ እኛም፥ ከእርስዎ፥ ጋር፥ ነን፥\nከእንግዲህ፥ ወዲህ፥ ፈሪዎች፥ እንሁን፥ እግዚአብሔር፥\nይሰማል፥ ከእንግዲህ፥ ወዲህ፥ መከራ፥ አያገኘዎትም፥\nየማይገባ፥ ቃል፥ አይሰሙም፥ እግዚአብሔር፥ ከእርስዎ፥ ጋር፥\nነው፥ እኔም፥ ከእርስዎ፥ ጋር፥ ነኝ፥ እናንተም፥ አትፍሩ፥\nእግዚአብሔር፥ ይመራችኋል፥",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ግጥም",
