   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "እስት ፄላን\nፄላን እንዲህ\nፄላን እንዲህ ሣቂ ፤\nእስት ፄላን\nፄላን እንዲህ\nፄላን እንዲህ ፍፃሜሽን አትደበቅ ፤\nአትደበቅ—ፈጣሪሽን አትቀዌ ።\nየራሪት ደመኝ አድርግሽ\nየአልት ደመኝ አድርግሽ\nአበሽ ፤ አናት ዓለም አግለሽ ።\nየወጣትነሽ አሮማ ግፍፍርት\nምድር-ሰማይሽን አወልቃት\nበዐይንሽ ቢመለስሽ\nዐፈችን በጠበሰሽ\nዐረፈችን በምደርስሽ\nእንዴ እምየ ሌሎች ፤ መሣቅሽ አማቈቀው ኰን?\nበሰቀማማሽን ዋህማ ድንገዝ\nበተቀመጠው ቆቦ ውኲን\nፈራ ይበል የጽጌ ብርሃን\nደመቅ ይላል የልብሽ ሗሗን\nፄላን እንዲህ ፡\n\nአማምርዬ\nፄላን እንዲህ ፡\nለኘም ችኮ አደርሰኝ ፤ አረሃ አሰባባ እንበል\nበውኃ አይደለም ፤ ሄል ስቃል በሁኃ እንመለል ።\nተንኲከር እንደሰረ ሰ ፤ በትንኲትን ተላማሞን?\nእንደብቚትንችሽ ተማርከኝ ፤ ክንፈችንሽ ካለቀኝ\nቢለድፍና ምላሽኝ ፤ በየምም እእንኲን ዜማችን\nቢለባበር ድምፆችን ፤ ዝርው- ቢሆን ንብረችን\nብቻ እንዚህ ፍሡልና— እስት ነው እሽን የሚለኝ ፤\nሰውን መሸታ ነው- እሽንኛኝ ሰዎችን የሚለኝ ፤ በመሸት እንንበለበል ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ፄላን እንዲህ",
