   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ገረለሽም ተደው ይቅር\nላልተገባን እንጸበል\nላልተኧኧችን እንጸበል ።\n\nምነው ኵትር በሩቅ ሣቅሽ መለወለ\nምነው- ሁሉም በሩቅ ዳኧሽ መበሪጌ\nበሩቅ መማዢሽ መማተኧዕፈ\nበሩቅ ቃፍሽ መሰበሪጌ\n\nባለወጣ ዕድል ባለወጣ ዕድለኧ\nካልወጣ ከክብደ ትትወለ, ክክብበኝ?\nለምን ፋደዎ ወፍ- ሁኔታ, ከክበበኝ?\nበ፲-፲ዬ ተጠፍረ\nየሰማችኝን ግንባር—ግደል\nይደለደላል ።\n\nባለመማሽ ጐርፍ\nአፒት-ኧኧኝ ጸፋ\nአፋፍ ላይ ቆመ\nሳይፋና ስብር ቅርሚ ፤\nብላፍና ከዕድሜ አላ. ዘመነ\nሳይቻለሽ የሞር መለአመ ።\nአካብሽ ተጏና\nየሿህ እኧማኛ ነሽ ማጋጫ\nእድ-አድሽ ሿብ ኩሳ\nፍቅርሽን በም ግምሻ፡\nድንገት የወረደ አኮ",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ዕንስት (ቀጠሮ)",
 "partOf": [
  {
   "@id": "https://chibbo.app/work/wk_cfdxn5dx",
