 "author": [
  {
   "@id": "https://chibbo.app/person/pe_9wzx8wkp",
   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "ያቺ ቀንጔፄ ተመለሰች\n      እየዘመች\n      እማማ ጭው ስትል\n      ቡና ሲጠጡ ።\n\n“ጋሼ ካለወሀሁ?” ትላለች\nየይቤን ንብርሃን እየቀቀች\n“እሺ ቀንጔፄ” እላለሁ\nመጽሐፍትን እየሻኩ ።\nተማወኃለች\nየባለ የቆሙን ታወለች\nቀንጔፄዮ ፤ በይናዋ የቀንጔፄዮ\nጥርሷን ፍልቀቅ አደረገች\nከንፈሯን እየፋተች\n ትንፍትንፍ አለች ፤\n(ግን ድንገት ልታደርሰው\nስሟቷን እንኴን እንዲገነዘብው)\n“ምነው ቀንጔፄዮ?”\n“ምንም አይደለም ጋሼሬ”\n\nብር ብላ ትሔዳለች\nብር ብላ ትመለሳለች\nፈዳሏን በድፍዋ ጨፍማ ፤\n(በይና ጥላ ነበረባት\nትምህርት አሟከላባት)\n“አስተማርችሁኝ?” ትላለች\nየይቤን ብርሃን እየቀቀች\n“እሺ ቀንጔፄ” እላለሁ\nመጽሐፍትን እየሻኩ ።\n\nአበባ ጠቍማለች\n       ቀንጔፄዮ\n       ስንፍቷን እንደ ጠቍመች\n\nማቲን ያስኀሤጊ እደላት ።\n       ይዟትና\n       ወደ አደርጊ አቅፋትና\n       ሀ—በይ ሰላት\n       ሀ—በይ ሰላት\n       አቀፍና\nየማቲ ኀብን ሲያሰለሙኝ\n‘በ’ ን መንቀለ ‘ቀ’ ስትለኝ\n       አቀፍና\nደምፅዎ ሲይህም አሰማና ፤\n“ምነው ቀንጔፄዮ?”\n“ምንም አይደለም ጋሼሬ”\n\nብር ብላ ትሔዳለች\n       ቀንጔፄዮ\nእንደገና ልታመጣ ፤\n(አፍታ ሳትቆይ\n       ነመለሳች ቅንጥማ)\n“እንድ እมาย ከታለበስሽም?” ትላለች\nየይቤን ብርሃን እየቀቀች\n‘አይ ካለበስሽ’ እላታለሁ\nመጽሐፍትን እየሻኩ ።\nአለበሳት ፤ ናላ ከነቢ አላስማማት\nእኔና ሲያጥር ሲረዝምባት\nማሬ ገባኝ\nማሬ ገባች ።\nፈርደብኝ\nፈርደባት ።\n\nብር ብላ ሔደች ቀንጔፄ\nበማምሤቱ አኲቲ ናት\nነመለሳች የስሙኝቱ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "ያቺ ቀንጔፄ",
