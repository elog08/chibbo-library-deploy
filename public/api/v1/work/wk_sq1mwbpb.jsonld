   "@type": "Person",
   "name": "ደበበ ሰይፉ"
  }
 ],
 "description": "አለ ሌላ ዓለም\nካልቆ ሲታይ ውስጡ።\nእሶው ፊት ነው የቋሙ\nየእንባውን አዝመራ፤\nእሰው ፊት ነው ያለው፡\n‘ተስፋ ሲል ነኝ እኔ\nዕድል ሲባለ!’\nግን በውርር ቃችሁ ብትደብናው\nበአልፍና አህሰሌ ብትመረምረው፣\nከሣ ዛሬተማ ውርጭ ቀለበ ሣን\nተስፋን ታገኛለህ የመውኀኝ ጥብቂ !\nእንዲህ የሚለመወን\nአልመመት ሠየ ድቃ ፤\nየምታበራውን\nትንሿን ጨለቀ ።",
 "genre": "poetry",
 "inLanguage": "am",
 "name": "አል ሌላ ዓለም",
 "partOf": [
